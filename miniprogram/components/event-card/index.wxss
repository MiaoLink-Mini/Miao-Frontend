.event{position:relative;margin:0 0 30rpx;color:var(--ink);animation:event-enter .28s ease}
.event-heading{display:flex;align-items:center;justify-content:space-between;margin-bottom:12rpx;min-height:36rpx}
.event-identity{display:flex;align-items:center;gap:12rpx;min-width:0}
.event-label{font-size:23rpx;font-weight:600;color:var(--ink)}
.event-glyph{font-size:24rpx;color:var(--accent);width:28rpx}
.event-agent-logo{height:30rpx;width:30rpx}
.event-content{font-size:27rpx;line-height:1.8}
.user{background:var(--raised);border:1rpx solid var(--line);padding:20rpx 24rpx;border-radius:24rpx 24rpx 8rpx 24rpx;margin-left:30rpx}
.user .event-label{color:var(--muted);font-size:21rpx}
.user .event-content{font-size:26rpx;line-height:1.65}
.assistant{padding:0 2rpx}
.event-heading .message-menu{margin:0;width:48rpx;line-height:36rpx;padding:0;border:0;color:var(--quiet);background:transparent;font-size:24rpx;font-weight:400}
.message-actions{display:flex;gap:26rpx;padding:14rpx 0 0}
.terminal-action{font-size:21rpx;color:var(--muted);line-height:40rpx}
.message-actions .terminal-action{background:var(--raised);padding:4rpx 20rpx;border-radius:12rpx;color:var(--accent)}
.stream{color:var(--accent);animation:cursor-pulse 1s steps(2,end) infinite;font-size:26rpx}
.tool-shell{position:relative;overflow:hidden;border:1rpx solid var(--line);border-radius:22rpx;background:var(--surface)}
.tool-heading{display:flex;align-items:center;gap:12rpx;padding:18rpx 20rpx 8rpx}
.tool-symbol{display:flex;justify-content:center;align-items:center;width:28rpx;height:28rpx;flex-shrink:0;color:var(--positive);font-size:22rpx}
.tool-title{font:600 23rpx/1.5 ui-monospace,SFMono-Regular,Menlo,monospace;flex:1;min-width:0;overflow-wrap:anywhere}
.tool-status{color:var(--quiet);font-size:18rpx;flex-shrink:0}
.tool-shell.running .tool-status{color:var(--accent)}
.tool-shell.failed .tool-symbol,.tool-shell.failed .tool-status{color:var(--negative)}
.tool-summary{padding:0 20rpx 14rpx 60rpx;color:var(--muted);font:22rpx/1.7 ui-monospace,SFMono-Regular,Menlo,monospace;overflow-wrap:anywhere}
.tool-spinner{width:23rpx;height:23rpx;box-sizing:border-box;border:2rpx solid var(--line);border-top-color:var(--accent);border-right-color:var(--accent);border-radius:50%;animation:tool-spin .9s linear infinite}
.disclosure{color:var(--quiet);font-size:30rpx;transition:transform .22s ease}
.disclosure.expanded{transform:rotate(90deg)}
.tool-expanded{animation:event-enter .22s ease}
.output{padding:18rpx 20rpx;margin:0;background:var(--code);border-top:1rpx solid var(--line);color:var(--muted);font-size:21rpx;line-height:1.7;overflow-wrap:anywhere;white-space:pre-wrap;max-height:700rpx;overflow:auto}
.tool-controls{display:flex;justify-content:flex-end;gap:22rpx;padding:6rpx 20rpx;border-top:1rpx solid var(--line-soft)}
.compact-controls{padding:0 20rpx 8rpx 60rpx;border:0;justify-content:flex-start}
.compact-controls .terminal-action{font-size:19rpx;line-height:32rpx;color:var(--quiet)}
.truncated{font-size:20rpx;padding:8rpx 20rpx;color:var(--warning)}
.tool-running-line{position:absolute;bottom:0;left:0;width:35%;height:2rpx;background:var(--accent);animation:tool-travel 2.4s ease-in-out infinite}
.diff{border:1rpx solid var(--line);border-radius:24rpx;background:var(--surface);overflow:hidden}
.diff-summary{display:flex;align-items:center;gap:16rpx;padding:22rpx}
.diff-summary-icon{width:58rpx;height:58rpx;background:var(--accent-soft);color:var(--accent);border-radius:18rpx;display:flex;align-items:center;justify-content:center;font:32rpx monospace}
.diff-summary .tiny{margin-top:5rpx;display:flex;gap:14rpx;align-items:center}
.stat-add{color:var(--positive);font:20rpx ui-monospace,monospace}
.stat-remove{color:var(--negative);font:20rpx ui-monospace,monospace}
.inline-file{display:flex;align-items:center;gap:12rpx;padding:15rpx 22rpx;border-top:1rpx solid var(--line-soft);font-size:21rpx}
.file-type{color:var(--quiet);font-size:24rpx}
.file-path{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-family:ui-monospace,monospace;color:var(--muted)}
.plan{padding:20rpx 22rpx;border-left:2rpx solid var(--accent);border-radius:0 20rpx 20rpx 0;background:var(--surface)}
.plan-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:12rpx}
.plan-step{display:flex;gap:12rpx;align-items:flex-start;margin:9rpx 0;font-size:24rpx;color:var(--muted)}
.plan-step.completed{color:var(--quiet)}
.plan-step.running{color:var(--accent)}
.step-bullet{width:26rpx;height:34rpx;display:flex;align-items:center;justify-content:center;flex-shrink:0;color:var(--positive)}
.request-action{display:flex;justify-content:space-between;align-items:center;margin-top:18rpx;padding:14rpx 20rpx;border:1rpx solid var(--line);background:var(--accent-soft);color:var(--accent);border-radius:16rpx;font-size:24rpx}
.approval,.question{border:1rpx solid var(--line);background:var(--surface);border-radius:24rpx;padding:22rpx}
.result{padding:18rpx 22rpx;background:var(--add-bg);border-radius:22rpx;border:1rpx solid var(--add-mark)}
.result .event-glyph{color:var(--positive)}
.error{background:var(--remove-bg);border:1rpx solid var(--remove-mark);border-radius:22rpx;padding:22rpx}
.status,.usage{color:var(--quiet);padding:8rpx 0}
.status .event-content,.usage .event-content{font-size:23rpx}
.md-block{margin:0 0 12rpx}
.md-block:last-child{margin-bottom:0}
.md-block.heading{font-size:30rpx;font-weight:600;margin:20rpx 0 10rpx}
.md-block.bullet{display:flex;gap:14rpx}
.md-bullet{color:var(--accent);flex-shrink:0}
.md-block.quote{border-left:3rpx solid var(--line);padding-left:20rpx;color:var(--muted)}
.md-strong{font-weight:650}
.md-inline-code{font:24rpx/1.5 ui-monospace,monospace;background:var(--raised);color:var(--accent);border-radius:5rpx;padding:2rpx 6rpx}
.message-code{background:var(--code);border:1rpx solid var(--line);border-radius:18rpx;overflow:hidden;margin:20rpx 0}
.code-heading{display:flex;justify-content:space-between;align-items:center;background:var(--surface);padding:0 20rpx;color:var(--quiet);font:20rpx monospace}
.code-copy{margin:0;padding:0;border:0;background:transparent;color:var(--muted);line-height:60rpx;font-size:20rpx}
.code-lines{display:table;min-width:100%;padding:12rpx 0;font:22rpx/40rpx ui-monospace,monospace}
.message-code-line{display:flex;white-space:pre;padding-right:20rpx}
.code-number{flex-shrink:0;width:58rpx;text-align:right;margin-right:20rpx;color:var(--quiet);font-size:19rpx;user-select:none}
.syntax-keyword{color:var(--accent)}
.syntax-string{color:var(--positive)}
.syntax-number{color:var(--syntax)}
.syntax-comment{color:var(--quiet)}
.large .body{font-size:32rpx}
.large .tool-summary,.large .output{font-size:26rpx}
@keyframes event-enter{from{opacity:0;transform:translateY(8rpx)}
to{opacity:1;transform:translateY(0)}
}
@keyframes cursor-pulse{50%{opacity:0}
}
@keyframes tool-spin{to{transform:rotate(360deg)}
}
@keyframes tool-travel{0%{transform:translateX(-120%);opacity:0}
30%{opacity:1}
100%{transform:translateX(390%);opacity:0}
}

.message-more{background:var(--surface);color:var(--accent);margin-top:18rpx;border:1rpx solid var(--line);border-radius:16rpx;}

/* Per-page refinement: explicit slots, readable metadata and stable hit areas. */
.tool-symbol,.event-glyph,.step-bullet,.diff-summary-icon,.file-type,.disclosure{display:flex;align-items:center;justify-content:center;flex:none}
.tool-heading{min-height:78rpx;gap:12rpx}
.tool-title{flex:1;min-width:0;overflow-wrap:anywhere}
.tool-status{flex:none}
.tool-controls{min-height:56rpx}
.terminal-action{display:inline-flex;align-items:center;gap:6rpx;min-height:62rpx}
.tool-summary .body{font-size:24rpx}
.inline-file{gap:10rpx;min-width:0}
.file-path{min-width:0;flex:1}
.inline-file>.stat-add,.inline-file>.stat-remove{flex:none}
.stream{display:inline-block;width:6rpx;height:24rpx;background:var(--accent);vertical-align:middle;margin-left:5rpx;border-radius:2rpx}
.message-menu{display:flex!important;align-items:center;justify-content:center;min-width:60rpx;min-height:60rpx}
.request-action{display:flex;align-items:center;justify-content:space-between;min-height:80rpx}
.panel-action .terminal-action{display:flex;justify-content:flex-start}

.usage-inline{display:flex;align-items:baseline;gap:12rpx;min-width:0;flex-wrap:wrap}
.usage-inline-title{font-size:24rpx;font-weight:600;flex:none}
.usage-inline-value{font-size:24rpx;color:var(--muted);line-height:1.6;overflow-wrap:anywhere;white-space:normal}
