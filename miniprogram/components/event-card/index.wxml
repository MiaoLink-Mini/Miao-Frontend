<view class="event {{item.type}} {{large ? 'large' : ''}} {{item.complete === false ? 'streaming' : ''}}">
 <block wx:if="{{item.type === 'tool'}}"><view class="tool-shell {{item.state}}"><view class="tool-heading" bindtap="toggle" role="button" aria-label="{{expanded ? '收起工具输出' : '展开工具输出'}}"><view class="tool-symbol"><view wx:if="{{item.state === 'running'}}" class="tool-spinner"></view><ui-icon name="{{stateIcon}}" size="{{28}}" tone="accent" wx:else/></view><text class="tool-title">{{item.title || 'Tool'}}</text><text class="tool-status">{{stateLabel}}</text><view class="disclosure {{expanded ? 'expanded' : ''}}"><ui-icon name="chevron-right" size="{{32}}" tone="quiet" /></view></view><view class="tool-summary"><text class="body" selectable>{{item.text}}</text></view><view wx:if="{{expanded}}" class="tool-expanded"><view class="output mono"><text selectable>{{outputText || '暂无输出'}}</text></view><view class="tool-controls"><text class="terminal-action" bindtap="toggle">收起</text><text wx:if="{{outputMore}}" class="terminal-action" bindtap="moreOutput">更多输出</text><text class="terminal-action" bindtap="copy">复制输出</text></view><view wx:if="{{item.truncated}}" class="truncated">输出已截断</view></view><view wx:else class="tool-controls compact-controls"><view class="terminal-action inline-action" bindtap="toggle"><text>查看输出</text><ui-icon name="arrow-up-right" size="{{28}}" tone="accent" /></view></view><view wx:if="{{item.state === 'running'}}" class="tool-running-line"></view></view></block>
 <block wx:elif="{{item.type === 'usage'}}"><view class="usage-inline"><ui-icon name="activity" size="{{28}}" tone="accent"/><text class="usage-inline-title">本轮用量</text><text class="usage-inline-value" selectable>{{item.text}}</text></view></block>
 <block wx:elif="{{item.type === 'diff'}}"><view class="diff-summary" bindtap="open" role="button"><view class="diff-summary-icon"><ui-icon name="diff" size="{{38}}" tone="accent" /></view><view class="grow"><view class="event-label">{{item.title || '文件变更'}}</view><view class="tiny">{{fileCount}} 个文件 <text class="stat-add">+{{added}}</text> <text class="stat-remove">−{{removed}}</text></view></view><view class="disclosure"><ui-icon name="chevron-right" size="{{32}}" tone="quiet" /></view></view><view wx:for="{{item.files}}" wx:key="id" class="inline-file" bindtap="open"><view class="file-type"><ui-icon name="file" size="{{32}}" tone="accent" /></view><text class="file-path">{{item.name}}</text><text class="stat-add">+{{item.added}}</text><text class="stat-remove">−{{item.removed}}</text></view></block>
 <block wx:elif="{{item.type === 'plan'}}"><view class="plan-header" bindtap="open"><text class="event-label">执行计划</text><view class="tiny"><ui-icon name="arrow-up-right" size="{{32}}" tone="accent" /></view></view><view wx:for="{{item.steps}}" wx:key="index" class="plan-step {{item.state}}"><view class="step-bullet"><view wx:if="{{item.state === 'running'}}" class="tool-spinner"></view><ui-icon name="{{item.state === 'completed' ? 'check' : item.state === 'cancelled' ? 'minus' : 'clock'}}" size="{{24}}" tone="accent" wx:else/></view><text>{{item.label}}</text></view></block>
 <block wx:else><view class="event-heading"><view class="event-identity"><view wx:if="{{item.type === 'user'}}" class="event-glyph"><ui-icon name="prompt" size="{{32}}" tone="accent" /></view><image wx:elif="{{item.type === 'assistant' && agent.icon}}" class="event-agent-logo" src="{{agent.icon}}" mode="aspectFit"/><view wx:else class="event-glyph"><ui-icon name="{{item.type === 'result' ? 'check-circle' : item.requestId ? 'shield' : 'activity'}}" size="{{28}}" tone="accent" /></view><text class="event-label">{{item.type === 'user' ? '你' : item.type === 'assistant' ? agent.name || 'Agent' : item.title || '动态'}}</text></view><button wx:if="{{item.type === 'assistant' || item.type === 'user' || item.type === 'result'}}" class="message-menu inline-action" size="mini" bindtap="toggleActions" aria-label="消息操作"><ui-icon name="more" size="{{38}}" tone="accent" /></button></view>
 <view class="event-content" bindlongpress="toggleActions"><block wx:for="{{blocks}}" wx:key="id" wx:for-item="block"><view wx:if="{{block.kind === 'code'}}" class="message-code"><view class="code-heading"><text>{{block.language}}</text><button class="code-copy" size="mini" bindtap="copyCode" data-id="{{block.id}}">复制</button></view><scroll-view scroll-x><view class="code-lines"><view wx:for="{{block.lines}}" wx:for-item="line" wx:key="number" class="message-code-line"><text class="code-number">{{line.number}}</text><text selectable><text wx:for="{{line.segments}}" wx:for-item="seg" wx:key="index" class="syntax-{{seg.kind}}">{{seg.text}}</text></text></view></view></scroll-view></view><view wx:else class="md-block {{block.kind}}"><text wx:if="{{block.kind === 'bullet'}}" class="md-bullet">·</text><text class="body" selectable><text wx:for="{{block.segments}}" wx:for-item="seg" wx:key="index" class="md-{{seg.kind}}">{{seg.text}}</text></text></view></block><text wx:if="{{!blocks.length && item.text}}" class="body" selectable>{{item.text}}</text><view wx:if="{{item.complete === false}}" class="stream" aria-hidden="true"></view></view>
 <button wx:if="{{messageMore}}" size="mini" class="message-more inline-action" bindtap="moreMessage">展开更多<ui-icon name="arrow-down" size="{{28}}" tone="accent" /></button><view wx:if="{{item.requestId}}" class="request-action" bindtap="open" role="button">{{item.state === 'resolved' ? '查看结果' : item.type === 'approval' ? '审阅请求' : '回答问题'}} <view><ui-icon name="arrow-up-right" size="{{32}}" tone="accent" /></view></view><view wx:if="{{item.panel}}" class="panel-action" bindtap="open"><view class="terminal-action inline-action"><text>查看详情</text><ui-icon name="arrow-up-right" size="{{28}}" tone="accent" /></view></view><view wx:if="{{actionsVisible}}" class="message-actions"><text class="terminal-action" bindtap="copy">复制</text><text wx:if="{{!readonly}}" class="terminal-action" bindtap="quote">引用</text></view></block>
</view>
