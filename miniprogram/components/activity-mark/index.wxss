.activity-mark{position:relative;display:inline-flex;width:44rpx;height:44rpx;color:var(--accent);vertical-align:middle}
.bloom{position:absolute;inset:0}
.spoke{position:absolute;left:46%;top:3%;width:8%;height:94%}
.spoke::before{content:'';display:block;background:currentColor;width:100%;height:32%;border-radius:3rpx}
.bloom-core{position:absolute;width:18%;height:18%;left:41%;top:41%;background:currentColor;border-radius:50%}
.active .bloom{animation:bloom-turn 5s linear infinite}
.active .spoke::before{animation:petal 1.5s ease-in-out infinite}
.large{width:170rpx;height:170rpx}
.small{width:28rpx;height:28rpx}
.reduced .bloom,.reduced .spoke::before{animation:none}
@keyframes bloom-turn{to{transform:rotate(360deg)}
}
@keyframes petal{50%{opacity:.58}
}
