<view wx:if="{{open}}" class="theme-overlay" catchtouchmove="noop"><view class="theme-backdrop" bindtap="close"></view><view class="theme-sheet"><view class="sheet-grip"></view><view class="row"><view><view class="eyebrow">MAKE IT YOURS</view><view class="sheet-title">换一种心情</view></view><button class="sheet-close inline-action" size="mini" bindtap="close" aria-label="关闭主题选择"><ui-icon name="close" size="{{38}}" tone="accent" /></button></view><view class="theme-content"><view class="theme-grid"><button wx:for="{{themes}}" wx:key="id" class="theme-option {{selected === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="choose" aria-label="{{item.name}}主题"><view class="theme-mini" style="background:{{item.canvas}};border-color:{{item.line}}"><view class="mini-line" style="background:{{item.quiet}}"></view><view class="mini-bubble" style="background:{{item.surface}}"><view class="mini-bubble-line" style="background:{{item.accent}}"></view><view class="mini-bubble-line second" style="background:{{item.muted}}"></view></view><view class="mini-input" style="background:{{item.raised}}"><view class="mini-input-icon" style="color:{{item.accent}}"><ui-icon name="prompt" size="{{32}}" tone="accent" theme="{{item.id}}" /></view><view class="mini-input-action" style="background:{{item.accent}}"></view></view></view><view class="theme-caption"><text>{{item.name}}</text><view class="theme-check"><ui-icon name="check" size="{{26}}" tone="accent" wx:if="{{selected === item.id}}"/></view></view></button></view><view class="row motion-label"><text>动效</text></view><view class="motion-options"><button size="mini" class="motion-option {{motion === 'full' ? 'selected' : ''}}" bindtap="motionChange" data-id="full">灵动</button><button size="mini" class="motion-option {{motion === 'reduced' ? 'selected' : ''}}" bindtap="motionChange" data-id="reduced">柔和</button><button size="mini" class="motion-option {{motion === 'off' ? 'selected' : ''}}" bindtap="motionChange" data-id="off">关闭</button></view></view></view></view>
