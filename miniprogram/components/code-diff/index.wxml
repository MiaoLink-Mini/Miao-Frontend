<view class="code-diff {{compact ? 'compact' : ''}} {{wrap ? 'wrapped' : ''}}"><view class="diff-toolbar"><view class="diff-stats"><text class="stat-add">+{{added}}</text><text class="stat-remove">−{{removed}}</text><text class="stat-hunks">{{hunks}} 段</text></view><view class="diff-tools"><button class="diff-tool-button" wx:if="{{hunks}}" size="mini" bindtap="headers">{{showHeaders ? '隐藏标头' : '标头'}}</button><button class="diff-tool-button" wx:if="{{!compact}}" size="mini" bindtap="lineWrap">{{wrap ? '横向' : '换行'}}</button><button class="diff-tool-button" size="mini" bindtap="copy">复制</button></view></view><scroll-view scroll-x="{{!wrap}}" class="diff-scroll"><view class="diff-code"><block wx:for="{{rows}}" wx:key="id"><button wx:if="{{item.kind === 'fold'}}" class="context-fold" size="mini" bindtap="context">··· 展开 {{item.count}} 行上下文</button><view wx:elif="{{item.kind === 'hunk' || item.kind === 'meta'}}" class="diff-meta {{item.kind}}"><text selectable>{{item.text}}</text></view><view wx:else class="diff-line {{item.kind}}"><text class="line-number old">{{item.oldLine === null ? '' : item.oldLine}}</text><text class="line-number new">{{item.newLine === null ? '' : item.newLine}}</text><text class="line-sign">{{item.sign}}</text><text class="line-code" selectable><text wx:for="{{item.segments}}" wx:for-item="segment" wx:key="index" class="{{segment.changed ? 'inline-change' : ''}}">{{segment.text}}</text></text></view></block></view></scroll-view><button wx:if="{{hasMore}}" class="diff-more inline-action" size="mini" bindtap="more">展开更多行<ui-icon name="arrow-down" size="{{28}}" tone="accent" /></button><view wx:if="{{truncated}}" class="diff-foot">主机上报的差异已截断</view><view wx:if="{{!rows.length}}" class="diff-foot">暂无差异正文</view></view>
