.session-name{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;margin-top:14rpx}
.permission-grid{display:flex;gap:16rpx}
.permission{width:50%;box-sizing:border-box;border:1rpx solid var(--line);padding:24rpx;border-radius:24rpx;background:var(--surface);position:relative;transition:background .2s,border-color .2s,transform .2s}
.permission:active{transform:scale(.98)}
.permission.selected{border-color:var(--accent);background:var(--accent-soft)}
.permission-symbol{font-size:45rpx;color:var(--accent)}
.permission-name{font-size:31rpx;font-weight:500;margin:18rpx 0 8rpx}
.permission>text:not(.permission-symbol){color:var(--muted);font-size:21rpx}
.permission .selected-mark{position:absolute;right:24rpx;top:20rpx;color:var(--accent)}
.ttl-options{display:flex;flex-wrap:wrap;gap:12rpx}
button.ttl{width:auto;flex:1 1 calc(33.33% - 12rpx);margin:0;background:var(--surface);font-size:23rpx;border:1rpx solid var(--line);border-radius:16rpx;padding:18rpx 22rpx;font-weight:400;line-height:1.3;min-height:0}
.ttl.selected{background:var(--accent-soft);color:var(--accent);border-color:var(--accent)}
.custom-ttl{margin-top:20rpx}
.custom-ttl input{width:180rpx;min-height:70rpx;text-align:center;border:1rpx solid var(--line);border-radius:16rpx;background:var(--surface)}
.share-footnote{font-size:21rpx;color:var(--muted);margin:26rpx 0}
.invite-ready{border:1rpx solid var(--accent);border-radius:26rpx;padding:28rpx;margin-top:26rpx;animation:page-enter .3s both;background:var(--accent-soft)}
.invite-ready>.muted{display:block;margin-top:10rpx;font-size:23rpx}
.share-record .tiny{margin-top:10rpx}
button.revoke-link{width:auto;border:0;border-radius:0;font-size:21rpx;background:transparent;color:var(--negative);padding:16rpx 0 0;min-height:0;text-align:left;font-weight:400}
.activity-row{padding:20rpx 0;border-bottom:1rpx solid var(--line-soft);display:flex;justify-content:space-between;font-size:23rpx}
.small-empty{padding:30rpx}
.quiet-button{background:transparent;font-weight:400;color:var(--muted)}

/* Per-page refinement: explicit slots, readable metadata and stable hit areas. */
.title{font-size:46rpx}
.permission{width:auto;min-width:0;flex:1 1 0;padding:24rpx 20rpx}
.permission-symbol{display:flex;align-items:center;height:44rpx}
.permission-name{font-size:28rpx}
.permission>.selected-mark{display:flex;align-items:center;justify-content:center;width:32rpx;height:32rpx;right:18rpx;top:18rpx}
button.ttl{min-height:76rpx;line-height:1.4;padding:18rpx 12rpx}
.share-record .row{align-items:flex-start;gap:14rpx}
.share-record .row>view{flex:1;min-width:0}
.share-record .badge{flex:none}
.share-record .tiny{overflow-wrap:anywhere}
button.revoke-link{display:inline-flex;align-items:center;min-height:72rpx;line-height:1.3}
.activity-row{gap:16rpx}
.activity-row>text:first-child{min-width:0;flex:1}
.activity-row>.tiny{flex:none}
