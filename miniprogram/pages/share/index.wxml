<page-meta root-background-color="{{themeCanvas || '#171816'}}" page-style="background-color:{{themeCanvas || '#171816'}}" />
<view class="app-surface {{themeId}} motion-{{motionMode}} {{pageActive ? '' : 'is-hidden'}}" style="{{themeStyle}}">
<view class="page"><view class="row"><view><view class="eyebrow">BETTER TOGETHER</view><view class="title">分享会话</view></view><button class="icon-button inline-action" bindtap="showThemes" aria-label="主题与动效"><ui-icon name="palette" size="{{38}}" tone="accent" /></button></view><view class="subtitle session-name">{{session.title}}</view>
<view wx:if="{{!live || !session}}" class="empty">请先连接可访问的会话</view><block wx:else>
<view class="section-title section">对方可以</view><view class="permission-grid"><view class="permission {{permission === 'read' ? 'selected' : ''}}" bindtap="choosePermission" data-id="read"><view class="permission-symbol"><ui-icon name="eye" size="{{32}}" tone="accent" /></view><view class="permission-name">只读</view><text>浏览记录与改动</text><view class="selected-mark"><ui-icon name="check" size="{{26}}" tone="accent" wx:if="{{permission === 'read'}}"/></view></view><view class="permission {{permission === 'control' ? 'selected' : ''}}" bindtap="choosePermission" data-id="control"><view class="permission-symbol"><ui-icon name="terminal" size="{{32}}" tone="accent" /></view><view class="permission-name">协作</view><text>发指令、停止、审批</text><view class="selected-mark"><ui-icon name="check" size="{{26}}" tone="accent" wx:if="{{permission === 'control'}}"/></view></view></view>
<view class="section-title section">有效时间</view><view class="ttl-options"><button wx:for="{{ttls}}" wx:key="label" class="ttl {{index === ttlIndex ? 'selected' : ''}}" bindtap="chooseTTL" data-index="{{index}}" disabled="{{creating || pending}}">{{item.label}}</button></view><view wx:if="{{ttlIndex === 4}}" class="custom-ttl row gap"><input type="number" value="{{minutes}}" bindinput="minutes" disabled="{{creating || pending}}" maxlength="5"/><text class="muted">分钟（15–10080）</text></view>
<view class="share-footnote">仅首位接受者可用，请勿转发邀请。</view>
<button class="primary inline-action" bindtap="create" loading="{{creating}}" disabled="{{creating || pending}}">创建邀请<ui-icon name="arrow-up-right" size="{{28}}" tone="accentInk" /></button><view wx:if="{{error}}" class="error">{{error}}</view><button wx:if="{{pending}}" class="secondary" bindtap="recoverInvite" disabled="{{creating}}">查询原邀请</button>
<view wx:if="{{hasInvite}}" class="invite-ready"><view class="row"><text class="section-title">邀请已就绪</text><text class="badge">{{invitation.permissionLabel}}</text></view><text class="muted">{{invitation.expiryLabel}} 前有效</text><button open-type="share" class="primary section inline-action">发送给微信好友<ui-icon name="arrow-up-right" size="{{28}}" tone="accentInk" /></button></view>
<view class="row section"><text class="section-title">分享管理</text><button class="quiet-button small" bindtap="load">刷新</button></view>
<view wx:for="{{shares}}" wx:key="id" class="card share-record"><view class="row"><view><view class="card-title">{{item.recipientName || '等待好友接受'}}</view><view class="tiny">{{item.permissionLabel}} · {{item.expiryLabel}} 到期</view></view><text class="badge">{{item.stateLabel}}</text></view><button wx:if="{{item.active}}" class="revoke-link" data-id="{{item.id}}" bindtap="revoke">撤销分享</button></view><view wx:if="{{!shares.length}}" class="empty small-empty">还没有分享</view><button wx:if="{{moreShares}}" bindtap="loadMore" class="secondary small">加载更多</button>
<view wx:if="{{activity.length}}" class="section-title section">协作动态</view><view wx:for="{{activity}}" wx:key="id" class="activity-row"><text>{{item.actorName || '协作者'}} · {{item.actionLabel}}</text><text class="tiny">{{item.stateLabel}}</text></view><button wx:if="{{moreActivity}}" class="small secondary" bindtap="moreActivity">更多动态</button>
</block></view>
<theme-switcher open="{{themeSheet}}" selected="{{themeId}}" motion="{{motionMode}}" bind:close="closeThemes" bind:change="themeChange" bind:motion="motionChange"/>
</view>
