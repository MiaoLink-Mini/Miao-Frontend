<page-meta root-background-color="{{themeCanvas || '#171816'}}" page-style="background-color:{{themeCanvas || '#171816'}}" />
<view class="app-surface {{themeId}} motion-{{motionMode}} {{pageActive ? '' : 'is-hidden'}}" style="{{themeStyle}}">
<view class="welcome"><view class="row welcome-top"><text class="wordmark">喵连</text><button class="icon-button inline-action" bindtap="showThemes" aria-label="主题"><ui-icon name="palette" size="{{38}}" tone="accent" /></button></view><view class="welcome-art"><view class="orbit orbit-one"></view><view class="orbit orbit-two"></view><activity-mark active="{{pageActive}}" size="large"/></view><view class="welcome-heading">你的想法，</view><view class="welcome-heading muted-heading">值得立即实现。</view><view class="welcome-copy">随时连接你的 Coding Agent。</view><view class="welcome-bottom"><view wx:if="{{error}}" class="error">{{error}}</view><button wx:if="{{error}}" class="secondary connection-copy" bindtap="copyConnectionError">复制连接错误</button><button class="primary inline-action" bindtap="enter" disabled="{{busy}}" loading="{{busy}}">{{primaryLabel}}<ui-icon name="arrow-up-right" size="{{30}}" tone="accentInk" /></button></view></view>
<theme-switcher open="{{themeSheet}}" selected="{{themeId}}" motion="{{motionMode}}" bind:close="closeThemes" bind:change="themeChange" bind:motion="motionChange"/>
</view>
