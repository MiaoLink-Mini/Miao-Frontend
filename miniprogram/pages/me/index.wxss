.profile{display:flex;align-items:center;gap:22rpx;padding:28rpx}
.avatar{width:76rpx;height:76rpx;display:flex;align-items:center;justify-content:center;border:1rpx solid var(--accent);border-radius:22rpx;color:var(--accent);font-size:36rpx;font-weight:600;flex-shrink:0}
.account-name{font-size:30rpx;margin-bottom:8rpx;overflow-wrap:anywhere}
.profile .inline-status{font-size:22rpx;max-width:130rpx}
.row-icon{width:30rpx;color:var(--accent);font-size:29rpx;text-align:center}
.logout{margin-top:30rpx;color:var(--muted);font-weight:400}
.brand-footer{text-align:center;color:var(--quiet);font-size:20rpx;padding:24rpx}

/* Per-page refinement: explicit slots, readable metadata and stable hit areas. */
.row-icon{width:36rpx;height:40rpx}
.profile.card{border-color:var(--line);padding:28rpx 24rpx}
.profile .inline-status{flex:none;font-size:20rpx;text-align:right;max-width:148rpx}
.avatar{background:var(--raised);border-color:var(--line);width:80rpx;height:80rpx;border-radius:50%;overflow:hidden}
.account-name{line-height:1.4}
.brand-footer{letter-spacing:1rpx}
.logout{min-height:84rpx;background:transparent;border:1rpx solid var(--line-soft)}

.profile-avatar{display:block;width:100%;height:100%;border-radius:50%}

.page>button.primary{margin-top:30rpx}
