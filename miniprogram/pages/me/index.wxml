<page-meta root-background-color="{{themeCanvas || '#171816'}}" page-style="background-color:{{themeCanvas || '#171816'}}" />
<view class="app-surface {{themeId}} motion-{{motionMode}} {{pageActive ? '' : 'is-hidden'}} tabbed" style="{{themeStyle}}"><view class="page">
 <view class="screen-head"><view><view class="screen-kicker">账号与偏好</view><view class="title">我的</view></view><button class="icon-button inline-action" bindtap="showThemes" aria-label="主题与动效"><ui-icon name="palette" size="{{38}}" tone="accent" /></button></view>
 <view class="profile card" bindtap="editProfile" role="button" aria-label="编辑个人资料"><view class="avatar"><image class="profile-avatar" src="{{avatarPath}}" mode="aspectFit" aria-label="用户头像" /></view><view class="grow"><view class="account-name">{{accountTitle}}</view><text class="tiny">{{guest ? '点击登录，连接你的设备' : demo ? '演示账号' : '已登录'}}</text></view><text wx:if="{{!guest}}" class="inline-status {{connection === 'online' ? 'online' : 'offline'}}">{{connectionLabel}}</text></view>
 <view class="subhead">协作与设备</view><view class="surface-list"><view class="row-button" bindtap="open" data-url="/pages/shared/index"><view class="row-icon"><ui-icon name="arrow-up-right" size="{{32}}" tone="accent" /></view><view class="grow"><view>与我共享</view><text class="tiny">已接受的会话邀请</text></view><view class="chevron"><ui-icon name="chevron-right" size="{{32}}" tone="quiet" /></view></view><view class="row-button" bindtap="open" data-url="/pages/nodes/index"><view class="row-icon"><ui-icon name="monitor" size="{{32}}" tone="accent" /></view><text class="grow">设备管理</text><text class="tiny">{{onlineCount}} 台在线</text><view class="chevron"><ui-icon name="chevron-right" size="{{32}}" tone="quiet" /></view></view></view>
 <view class="subhead">偏好</view><view class="surface-list"><view class="row-button" bindtap="showThemes"><view class="row-icon"><ui-icon name="palette" size="{{32}}" tone="accent" /></view><text class="grow">主题与动效</text><text class="tiny">{{themeName}}</text><view class="chevron"><ui-icon name="chevron-right" size="{{32}}" tone="quiet" /></view></view><view class="row-button" bindtap="open" data-url="/pages/settings/index"><view class="row-icon"><ui-icon name="settings" size="{{32}}" tone="accent" /></view><text class="grow">通知与隐私</text><view class="chevron"><ui-icon name="chevron-right" size="{{32}}" tone="quiet" /></view></view></view>
 <view class="subhead">帮助</view><view class="surface-list"><view class="row-button" bindtap="open" data-url="/pages/guide/index?replay=1"><text class="grow">使用指南</text><view class="chevron"><ui-icon name="chevron-right" size="{{32}}" tone="quiet" /></view></view><view class="row-button" bindtap="open" data-url="/pages/diagnostics/index"><text class="grow">连接诊断</text><view class="chevron"><ui-icon name="chevron-right" size="{{32}}" tone="quiet" /></view></view><view class="row-button" bindtap="open" data-url="/pages/about/index"><text class="grow">关于</text><view class="chevron"><ui-icon name="chevron-right" size="{{32}}" tone="quiet" /></view></view></view>
 <button wx:if="{{guest}}" class="primary" bindtap="login">登录</button><button wx:else class="quiet-button logout" bindtap="logout">退出登录</button><view class="brand-footer">喵连 {{version}}</view>
</view><theme-switcher open="{{themeSheet}}" selected="{{themeId}}" motion="{{motionMode}}" bind:close="closeThemes" bind:change="themeChange" bind:motion="motionChange"/></view>
