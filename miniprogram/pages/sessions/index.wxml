<page-meta root-background-color="{{themeCanvas || '#171816'}}" page-style="background-color:{{themeCanvas || '#171816'}}" />
<view class="app-surface {{themeId}} motion-{{motionMode}} {{pageActive ? '' : 'is-hidden'}} tabbed" style="{{themeStyle}}">
  <connection-bar state="{{connection}}" label="{{connectionLabel}}"/>
  <view class="page">
    <view class="screen-head"><view><view class="screen-kicker">SESSIONS</view><view class="title">会话</view></view><button class="primary small inline-action" bindtap="open" data-url="/pages/create/index"><ui-icon name="plus" size="{{30}}" tone="accentInk" /> 新建</button></view>
    <view class="search-row"><view class="search-box"><view class="search-symbol"><ui-icon name="search" size="{{32}}" tone="accent" /></view><input class="search" placeholder="搜索会话" value="{{query}}" bindinput="search"/><button wx:if="{{query}}" class="clear-search inline-action" size="mini" bindtap="clearSearch" aria-label="清除搜索"><ui-icon name="close" size="{{38}}" tone="accent" /></button></view><button class="scope-trigger {{scopeCount ? 'selected' : ''}}" size="mini" bindtap="openFilters" aria-label="筛选设备、项目和 Agent">筛选{{scopeCount ? ' ' + scopeCount : ''}}</button></view>
    <view class="segmented organize-tabs"><button class="{{organization === 'all' ? 'selected' : ''}}" bindtap="organize" data-value="all">全部</button><button class="{{organization === 'pinned' ? 'selected' : ''}}" bindtap="organize" data-value="pinned">置顶</button><button class="{{organization === 'archived' ? 'selected' : ''}}" bindtap="organize" data-value="archived">归档</button><button class="shared-tab" bindtap="open" data-url="/pages/shared/index">与我共享</button></view>
    <scroll-view scroll-x enable-flex class="filter-scroll"><view class="filters status-filters"><text class="filter {{filter === 'all' ? 'active' : ''}}" data-value="all" bindtap="filter">所有状态</text><text class="filter {{filter === 'active' ? 'active' : ''}}" data-value="active" bindtap="filter">进行中</text><text class="filter {{filter === 'attention' ? 'active' : ''}}" data-value="attention" bindtap="filter">待处理</text><text class="filter {{filter === 'completed' ? 'active' : ''}}" data-value="completed" bindtap="filter">已完成</text><text class="filter {{filter === 'failed' ? 'active' : ''}}" data-value="failed" bindtap="filter">失败</text></view></scroll-view>
    <view wx:if="{{scopeCount}}" class="scope-summary"><text>{{nodeId ? nodeOptions[nodeIndex].name + ' / ' : ''}}{{projectId ? projectOptions[projectIndex].name + ' / ' : ''}}{{agentId ? agentOptions[agentIndex].name : ''}}</text><text class="link" bindtap="resetFilters">清除</text></view>
    <view wx:if="{{error}}" class="error">{{error}}</view>
    <button wx:if="{{unknown}}" class="secondary" bindtap="reconcile" disabled="{{busy}}">查询删除结果</button>
    <session-card wx:for="{{list}}" wx:key="id" session="{{item}}" swipeable="{{!demo && !busy && !unknown}}" revealed="{{swipedId === item.id}}" bind:reveal="revealSession" bind:delete="deleteSession" bind:rename="renameSession"/>
    <view wx:if="{{!list.length && !listLoading && !listError}}" class="list-empty"><view class="list-empty-icon"><ui-icon name="terminal" size="{{52}}" tone="accent" /></view><view class="list-empty-title">{{hasFilters ? '没有匹配的会话' : '还没有会话'}}</view><button wx:if="{{hasFilters}}" class="secondary" bindtap="resetFilters">清除筛选</button></view>
    <view wx:if="{{listLoading}}" class="loading-row"><activity-mark active size="small"/><text>加载中</text></view><view wx:if="{{listError}}" class="error">{{listError}}<button class="secondary small" bindtap="fetchList">重试</button></view><button wx:if="{{moreResults}}" class="secondary" bindtap="loadMore" disabled="{{listLoading}}">加载更多</button>
  </view>
  <view wx:if="{{filterSheet}}" class="flow-overlay" catchtap="closeFilters" catchtouchmove="noop"><view class="flow-sheet" catchtap="noop" role="dialog" aria-label="筛选范围"><view class="sheet-grip"></view><view class="row"><view class="sheet-title">筛选范围</view><button size="mini" class="sheet-close inline-action" bindtap="closeFilters" aria-label="关闭"><ui-icon name="close" size="{{38}}" tone="accent" /></button></view>
    <scroll-view scroll-y class="filter-body"><view class="field-label">设备</view><picker range="{{nodeOptions}}" range-key="name" value="{{draftNodeIndex}}" data-key="nodeIndex" bindchange="selectDraft"><view class="picker row"><text>{{nodeOptions[draftNodeIndex].name}}</text><view><ui-icon name="chevron-down" size="{{32}}" tone="quiet" /></view></view></picker>
    <view class="field-label">项目</view><picker range="{{projectOptions}}" range-key="name" value="{{draftProjectIndex}}" data-key="projectIndex" bindchange="selectDraft"><view class="picker row"><text>{{projectOptions[draftProjectIndex].name}}</text><view><ui-icon name="chevron-down" size="{{32}}" tone="quiet" /></view></view></picker>
    <view class="field-label">Agent</view><picker range="{{agentOptions}}" range-key="name" value="{{draftAgentIndex}}" data-key="agentIndex" bindchange="selectDraft"><view class="picker row"><text>{{agentOptions[draftAgentIndex].name}}</text><view><ui-icon name="chevron-down" size="{{32}}" tone="quiet" /></view></view></picker>
    </scroll-view><view class="sheet-actions"><button class="secondary" bindtap="resetDraft">重置</button><button class="primary" bindtap="applyFilters">应用筛选</button></view>
  </view></view>
<theme-switcher open="{{themeSheet}}" selected="{{themeId}}" motion="{{motionMode}}" bind:close="closeThemes" bind:change="themeChange" bind:motion="motionChange"/>
</view>
