<page-meta root-background-color="{{themeCanvas || '#171816'}}" page-style="background-color:{{themeCanvas || '#171816'}}" />
<import src="../../components/operation.wxml"/>
<view class="app-surface {{themeId}} motion-{{motionMode}} {{pageActive ? '' : 'is-hidden'}}" style="{{themeStyle}}">
<view class="session-screen {{preferences.largeText ? 'large' : ''}}">
 <connection-bar state="{{connection}}" label="{{connectionLabel}}"/>
 <block wx:if="{{session}}">
  <view class="session-header"><view class="terminal-topline"><view class="terminal-agent"><image class="agent-logo" src="{{session.agent.icon}}" mode="aspectFit"/><text>{{session.agent.name}}</text><view class="session-presence {{session.active ? 'active' : ''}}"></view></view><view class="header-actions"><button class="header-icon inline-action" size="mini" bindtap="showThemes" aria-label="切换主题"><ui-icon name="palette" size="{{38}}" tone="accent" /></button><button wx:if="{{live}}" class="header-icon inline-action" size="mini" bindtap="shareSession" aria-label="分享会话"><ui-icon name="arrow-up-right" size="{{38}}" tone="accent" /></button><button class="more inline-action" size="mini" bindtap="more" aria-label="会话菜单"><ui-icon name="more" size="{{38}}" tone="accent" /></button></view></view><view class="terminal-title">{{session.title}}</view><view class="header-meta"><view class="terminal-path"><view class="path-prefix"><ui-icon name="branch" size="{{32}}" tone="accent" /></view><text>{{session.project.name}}</text></view><text class="host-status"><text class="dot {{session.node.online ? '' : 'offline'}}"></text>{{session.node.name}}</text></view><view wx:if="{{reason}}" class="notice warning restore-notice"><text>{{reason}}</text><button wx:if="{{live && session.state === 'closed' && session.mode !== 'readonly' && session.agent.capabilities.historyImport}}" class="restore-button" bindtap="restoreSession" disabled="{{busy || unknown || !session.node.online || connection !== 'online'}}">恢复会话</button></view></view>
  <view class="session-nav"><view class="session-nav-current">对话<view class="nav-underline"></view></view><view wx:if="{{hasDiff}}" data-kind="diff" bindtap="panelQuick">变更 <ui-icon name="diff" size="{{28}}" tone="accent" /></view><view wx:if="{{hasPlan}}" data-kind="plan" bindtap="panelQuick">计划</view><view wx:if="{{hasUsage}}" data-kind="usage" bindtap="panelQuick">用量</view><text class="session-state {{session.state}}">{{cancelPending ? '正在停止' : session.stateLabel}}</text></view>
  <button wx:if="{{pendingRequest}}" class="pending-strip" bindtap="openPending"><ui-icon name="{{pendingRequest.kind === 'approval' ? 'shield' : 'help'}}" size="{{28}}" tone="accent" /><text>{{pendingRequest.kind === 'approval' ? '等待审批' : '等待回答'}}</text><text class="grow">{{pendingRequest.title}}</text><view class="inline-action"><text>查看</text><ui-icon name="chevron-right" size="{{28}}" tone="accent" /></view></button>
  <scroll-view class="timeline" scroll-y scroll-anchoring scroll-with-animation="{{scrollAnimated}}" scroll-into-view="{{scrollTarget}}" enhanced binddragstart="dragStart" binddragging="dragging" binddragend="dragEnd" bindscrolltolower="reachLatest" lower-threshold="40" upper-threshold="80"><view class="timeline-inner"><button wx:if="{{hasMore}}" class="earlier inline-action" size="mini" bindtap="loadMore"><ui-icon name="history" size="{{28}}" tone="accent" /> 更早的消息</button><view wx:if="{{loading}}" class="timeline-loading"><view class="skeleton"></view><view class="skeleton short"></view></view><view wx:if="{{gap}}" class="notice warning">正在补齐记录</view><event-card wx:for="{{items}}" wx:key="key" item="{{item}}" agent="{{session.agent}}" large="{{preferences.largeText}}" bind:open="openEvent" bind:quote="quote"/><view wx:if="{{session.active}}" class="thinking-row"><activity-mark active="{{pageActive}}" size="small" reduced="{{motionMode !== 'full'}}"/><text class="thinking-text">{{session.state === 'waiting_approval' ? '等待你的确认' : session.state === 'waiting_input' ? '等待你的回答' : cancelPending ? '正在停止' : '正在工作'}}</text><view class="thinking-dots"><view></view><view></view><view></view></view></view><view wx:if="{{!loading && !items.length}}" class="conversation-empty"><activity-mark size="large"/><view>下一步，交给 Agent。</view></view><view id="latest" class="latest-anchor"></view></view></scroll-view>
  <view wx:if="{{session.mode !== 'readonly'}}" class="composer" style="padding-bottom:{{keyboardHeight ? keyboardHeight + 'px' : 'env(safe-area-inset-bottom)'}}"><view wx:if="{{!following}}" class="jump" bindtap="latest"><ui-icon name="arrow-down" size="{{28}}" tone="accent" /> 最新消息</view><view wx:if="{{slashOpen}}" class="slash-popup" style="max-height:{{slashMaxHeight}}px"><view class="slash-heading"><text>快捷命令 <text class="slash-count">{{slashItems.length}}</text></text><button class="slash-close inline-action" size="mini" bindtap="dismissCommands" aria-label="关闭快捷命令"><ui-icon name="close" size="{{38}}" tone="accent" /></button></view><scroll-view class="slash-list" scroll-y enhanced="{{true}}" show-scrollbar="{{false}}" style="height:{{slashItems.length ? slashItems.length * (preferences.largeText ? 110 : 96) : 112}}rpx"><view wx:for="{{slashItems}}" wx:key="name" class="slash-option {{index === 0 ? 'suggested' : ''}}" bindtap="chooseCommand" data-name="{{item.name}}" role="button"><text class="slash-name">/{{item.name}}</text><view class="slash-detail"><text class="slash-label">{{item.label}}</text><text class="slash-description">{{item.description}}</text></view><view class="slash-enter"><ui-icon name="enter" size="{{32}}" tone="accent" /></view></view><view wx:if="{{!slashItems.length}}" class="slash-empty">没有匹配的命令</view></scroll-view><view class="slash-footer"><text>选择后按确认打开</text><text class="slash-raw" bindtap="literalCommand">作为文本发送</text></view></view><view wx:if="{{session.queue.length}}" class="queue-link" bindtap="openQueue"><text class="queue-count">{{session.queue.length}}</text> 条消息排队中 <view><ui-icon name="arrow-up-right" size="{{32}}" tone="accent" /></view></view><view class="composer-box {{composerFocused ? 'focused' : ''}}"><view wx:if="{{inputSummary}}" class="input-selection"><text>{{inputSummary}}</text><button size="mini" bindtap="removeInputs" aria-label="移除附件选择" class="inline-action"><ui-icon name="close" size="{{38}}" tone="accent" /></button></view><view class="prompt-line"><view class="prompt-glyph"><ui-icon name="prompt" size="{{32}}" tone="accent" /></view><textarea class="composer-input" value="{{draft}}" bindinput="input" focus="{{composerFocused}}" bindfocus="focusInput" bindblur="blurInput" auto-height maxlength="4000" placeholder="{{sendReason || '描述下一步，或输入 /'}}" adjust-position="{{false}}" bindkeyboardheightchange="keyboard" disabled="{{busy || unknown}}"/></view><view class="composer-actions"><view class="terminal-tools"><button class="composer-tool inline-action" size="mini" bindtap="attachments" aria-label="添加附件"><ui-icon name="plus" size="{{38}}" tone="accent" /></button></view><view class="send-tools"><button wx:if="{{session.active}}" class="terminal-stop inline-action" size="mini" bindtap="cancel" disabled="{{!canCancel || busy || unknown}}" aria-label="停止本轮"><ui-icon name="stop" size="{{38}}" tone="accent" /></button><button class="terminal-send inline-action" size="mini" bindtap="send" disabled="{{sendDisabled || busy || unknown}}" loading="{{busy && !cancelPending}}" aria-label="{{sendLabel}}"><ui-icon name="{{slashPending ? 'enter' : 'arrow-up'}}" size="{{36}}" tone="accentInk" /></button></view></view></view><template is="operation" data="{{busy,receipt,error,unknown}}"/></view><view wx:else class="readonly-footer"><button wx:if="{{!following}}" class="earlier inline-action" size="mini" bindtap="latest"><ui-icon name="arrow-down" size="{{28}}" tone="accent" /> 最新消息</button>只读会话</view>
 </block><view wx:else class="page empty"><view class="empty-title">{{loading ? '正在加载' : '会话不可访问'}}</view><button class="secondary" bindtap="tab" data-url="/pages/sessions/index">返回会话</button></view>
</view>

<view wx:if="{{menuOpen && session}}" class="flow-overlay" catchtap="closeMenu" catchtouchmove="noop">
  <view class="flow-sheet menu-sheet" catchtap="noop" role="dialog" aria-label="会话菜单">
    <view class="sheet-grip"></view><view class="row"><view class="sheet-title">会话菜单</view><button class="sheet-close inline-action" size="mini" bindtap="closeMenu" aria-label="关闭"><ui-icon name="close" size="{{38}}" tone="accent" /></button></view>
    <view class="menu-context">{{session.project.name}} · {{session.agent.name}}</view>
    <scroll-view scroll-y class="sheet-scroll" enhanced="{{true}}" show-scrollbar="{{false}}">
      <view wx:for="{{menuGroups}}" wx:key="title" wx:for-item="group"><view class="sheet-group-title">{{group.title}}</view><view class="menu-grid"><button wx:for="{{group.items}}" wx:key="kind" bindtap="selectMenu" data-kind="{{item.kind}}"><view class="row"><view class="menu-glyph"><ui-icon name="{{item.icon}}" size="{{36}}" tone="accent" /></view><text class="menu-label">{{item.label}}</text></view><text class="menu-note">{{item.note}}</text></button></view></view>
    </scroll-view>
  </view>
</view>
<theme-switcher open="{{themeSheet}}" selected="{{themeId}}" motion="{{motionMode}}" bind:close="closeThemes" bind:change="themeChange" bind:motion="motionChange"/>
</view>
