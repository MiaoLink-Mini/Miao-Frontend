.session-screen{height:100vh;display:flex;flex-direction:column;overflow:hidden;background:var(--canvas);font-weight:400}
.session-header{padding:12rpx 32rpx 24rpx;flex-shrink:0}
.terminal-topline{display:flex;align-items:center;justify-content:space-between;gap:14rpx}
.terminal-agent{display:flex;align-items:center;gap:12rpx;color:var(--muted);font-size:24rpx;font-weight:500}
.terminal-agent .agent-logo{width:32rpx;height:32rpx}
.session-presence{height:7rpx;width:7rpx;background:var(--quiet);border-radius:50%}
.session-presence.active{background:var(--positive);box-shadow:0 0 0 6rpx var(--add-bg)}
.header-actions{display:flex;align-items:center;gap:8rpx}
.session-screen button.header-icon,.session-screen button.more{width:56rpx;line-height:56rpx;margin:0;padding:0;border:0;border-radius:16rpx;background:transparent;color:var(--muted);font-size:29rpx}
.session-screen button.header-icon:first-child{color:var(--accent)}
.terminal-title{font-size:38rpx;font-weight:600;line-height:1.35;letter-spacing:-1rpx;margin-top:18rpx;overflow-wrap:anywhere}
.header-meta{display:flex;justify-content:space-between;align-items:center;gap:16rpx;margin-top:14rpx;font-size:21rpx}
.terminal-path{display:flex;gap:10rpx;align-items:center;font:21rpx/1.5 ui-monospace,monospace;color:var(--muted);min-width:0}
.terminal-path text:last-child{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.path-prefix{color:var(--accent);font-size:27rpx}
.host-status{font-size:20rpx;flex-shrink:0;color:var(--quiet)}
.host-status .dot{width:7rpx;height:7rpx;margin-right:8rpx}
.session-nav{display:flex;align-items:center;gap:34rpx;height:76rpx;padding:0 32rpx;border-top:1rpx solid var(--line-soft);border-bottom:1rpx solid var(--line);font-size:24rpx;color:var(--quiet);flex-shrink:0}
.session-nav>view{position:relative;height:100%;display:flex;align-items:center;gap:8rpx}
.session-nav-current{color:var(--ink)}
.nav-underline{position:absolute;bottom:-1rpx;height:3rpx;left:0;right:0;border-radius:4rpx;background:var(--accent)}
.session-state{margin-left:auto;font-size:19rpx;white-space:nowrap;color:var(--quiet)}
.session-state.running{color:var(--positive)}
.session-state.waiting_approval,.session-state.waiting_input{color:var(--warning)}
.timeline{flex:1;height:0;min-height:0}
.timeline-inner{padding:34rpx 28rpx 0}
.latest-anchor{height:24rpx}
.session-screen button.earlier{width:auto;margin:0 auto 28rpx;background:transparent;border:0;color:var(--quiet);font-size:21rpx;line-height:52rpx}
.thinking-row{display:flex;align-items:center;gap:14rpx;padding:4rpx 4rpx 18rpx}
.thinking-text{color:var(--accent);font-size:24rpx}
.thinking-dots{display:flex;gap:5rpx}
.thinking-dots view{width:4rpx;height:4rpx;border-radius:50%;background:var(--accent);animation:thought 1.5s ease-in-out infinite}
.thinking-dots view:nth-child(2){animation-delay:.2s}
.thinking-dots view:nth-child(3){animation-delay:.4s}
.composer{position:relative;z-index:3;flex-shrink:0;padding:10rpx 22rpx 0;background:var(--canvas)}
.composer-box{border:1rpx solid var(--line);border-radius:28rpx;background:var(--surface);padding:20rpx 20rpx 14rpx;margin-bottom:16rpx;box-shadow:var(--shadow);transition:border-color .2s,box-shadow .2s}
.composer-box.focused{border-color:var(--accent);box-shadow:0 0 0 2rpx var(--accent-soft)}
.prompt-line{display:flex;align-items:flex-start;gap:14rpx;padding:0 4rpx 12rpx}
.prompt-glyph{font:30rpx/46rpx ui-monospace,monospace;color:var(--accent);flex-shrink:0}
.composer-input{flex:1;min-width:0;width:auto;min-height:68rpx;max-height:180rpx;margin:0;padding:0;border:0;border-radius:0;background:transparent;font-size:27rpx;line-height:46rpx;color:var(--ink)}
.composer-actions{display:flex;align-items:center;justify-content:space-between;gap:12rpx}
.terminal-tools,.send-tools{display:flex;align-items:center;gap:10rpx}
.session-screen button.composer-tool{width:54rpx;margin:0;padding:0;border:0;border-radius:14rpx;background:transparent;color:var(--muted);font:30rpx/54rpx ui-monospace,monospace}
.session-screen button.terminal-send,.session-screen button.terminal-stop{width:62rpx;margin:0;padding:0;border-radius:20rpx;line-height:60rpx;font-size:30rpx;font-weight:500;flex-shrink:0}
.session-screen button.terminal-send{background:var(--accent);border:1rpx solid var(--accent);color:var(--accent-ink)}
.session-screen button.terminal-stop{border:1rpx solid var(--line);background:var(--raised);color:var(--muted);font-size:20rpx}
.jump{position:absolute;bottom:calc(100% + 12rpx);left:50%;transform:translateX(-50%);border:1rpx solid var(--line);background:var(--surface);border-radius:40rpx;padding:10rpx 28rpx;box-shadow:var(--shadow);color:var(--muted);font-size:21rpx;white-space:nowrap}
.queue-link{display:flex;align-items:center;gap:9rpx;color:var(--muted);font-size:21rpx;padding:4rpx 18rpx 14rpx}
.queue-link>text:last-child{margin-left:auto}
.queue-count{background:var(--accent-soft);color:var(--accent);font:19rpx monospace;padding:3rpx 10rpx;border-radius:8rpx}
.input-selection{display:flex;align-items:center;gap:10rpx;background:var(--raised);border-radius:14rpx;padding:4rpx 14rpx;margin-bottom:16rpx;font-size:21rpx;color:var(--muted)}
.input-selection>text{min-width:0;flex:1;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.input-selection button{width:42rpx;padding:0;margin:0;line-height:44rpx;border:0;background:transparent;color:var(--quiet)}
.readonly-footer{text-align:center;color:var(--quiet);font-size:22rpx;padding:20rpx 0 calc(20rpx + env(safe-area-inset-bottom));border-top:1rpx solid var(--line)}
.conversation-empty{text-align:center;padding:80rpx 30rpx;color:var(--muted);font-size:27rpx}
.conversation-empty>view{margin-top:40rpx}
.timeline-loading{padding:12rpx 10rpx 36rpx}
.slash-popup{position:absolute;bottom:100%;left:22rpx;right:22rpx;display:flex;flex-direction:column;overflow:hidden;background:var(--surface);border:1rpx solid var(--line);border-radius:26rpx;box-shadow:0 -12rpx 50rpx #00000030;animation:popup-in .22s ease}
.slash-heading{display:flex;align-items:center;justify-content:space-between;padding:8rpx 22rpx;border-bottom:1rpx solid var(--line);font-size:22rpx;color:var(--muted);flex-shrink:0}
.slash-count{color:var(--quiet);margin-left:12rpx}
.session-screen button.slash-close{width:50rpx;margin:0;padding:0;border:0;background:transparent;font-size:30rpx;line-height:50rpx;color:var(--muted)}
.slash-list{height:400rpx;min-height:0;flex:0 1 auto}
.slash-option{display:flex;align-items:center;gap:18rpx;padding:14rpx 22rpx;border-left:3rpx solid transparent;border-bottom:1rpx solid var(--line-soft)}
.slash-option.suggested{background:var(--accent-soft);border-left-color:var(--accent)}
.slash-name{width:114rpx;flex-shrink:0;font:23rpx ui-monospace,monospace;color:var(--accent)}
.slash-detail{display:flex;flex:1;min-width:0;flex-direction:column;gap:3rpx}
.slash-label{font-size:23rpx;color:var(--ink)}
.slash-description{font-size:19rpx;color:var(--quiet)}
.slash-enter{font-size:23rpx;color:var(--accent)}
.slash-footer{display:flex;align-items:center;justify-content:space-between;padding:13rpx 22rpx;border-top:1rpx solid var(--line);font-size:19rpx;color:var(--quiet);flex-shrink:0}
.slash-raw{color:var(--accent)}
.slash-empty{padding:26rpx 22rpx;font-size:24rpx;color:var(--muted)}
.large .slash-label,.large .slash-name{font-size:27rpx}
.large .slash-description{font-size:23rpx}
@keyframes thought{0%,100%{opacity:.2;transform:translateY(0)}
50%{opacity:1;transform:translateY(-3rpx)}
}
@keyframes popup-in{from{opacity:0;transform:translateY(12rpx)}
to{opacity:1;transform:translateY(0)}
}

.pending-strip{flex-shrink:0;display:flex;align-items:center;gap:16rpx;border:0;border-bottom:1rpx solid var(--line);border-radius:0;background:var(--accent-soft);padding:16rpx 32rpx;line-height:1.5;color:var(--accent);font-size:21rpx;font-weight:400}
.pending-strip .grow{color:var(--muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;text-align:left}
.menu-context{font-size:23rpx;color:var(--quiet);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.send-tools{gap:8rpx}

/* Per-page refinement: explicit slots, readable metadata and stable hit areas. */
.terminal-agent{min-width:0;flex:1}
.terminal-agent>text{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.header-actions{flex:none}
.session-screen button.header-icon,.session-screen button.more{height:68rpx;width:64rpx;display:flex;align-items:center;justify-content:center}
.terminal-title{font-size:36rpx}
.host-status{min-width:0;max-width:48%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.header-meta{gap:12rpx}
.terminal-path{min-width:0;flex:1}
.terminal-path>text{min-width:0}
.path-prefix,.prompt-glyph{display:flex;align-items:center;justify-content:center}
.prompt-glyph{height:46rpx}
.session-screen button.composer-tool{display:flex;align-items:center;justify-content:center;min-width:60rpx;height:62rpx}
.session-screen button.terminal-send,.session-screen button.terminal-stop{display:flex;align-items:center;justify-content:center;height:66rpx;line-height:1}
.jump,.earlier{display:flex;align-items:center;justify-content:center;gap:8rpx}
.queue-link>view:last-child{margin-left:auto}
.input-selection button{display:flex;align-items:center;justify-content:center;min-width:56rpx;min-height:56rpx}
.pending-strip{min-height:74rpx;gap:10rpx}
.pending-strip>text:first-of-type{flex:none}
.menu-glyph{display:flex;align-items:center;justify-content:center}
.menu-grid .row{justify-content:flex-start}
.menu-grid button{min-width:0}
.terminal-tools{min-width:0;flex:1}
.send-tools{flex:none}
.session-nav{gap:28rpx}
@media(max-width:350px){
.session-nav{gap:26rpx}
.terminal-title{font-size:34rpx}
.header-actions{gap:0}
}


.restore-notice{display:flex;align-items:center;justify-content:space-between;gap:20rpx}
.restore-notice text{flex:1;min-width:0;line-height:1.6;word-break:normal}
.session-screen button.restore-button{flex:0 0 auto;width:auto;min-width:0;max-width:100%;margin:0;padding:18rpx 22rpx;line-height:1.3;font-size:26rpx;font-weight:600;white-space:nowrap;border-radius:16rpx;background:var(--accent);color:var(--accent-ink)}
@media(max-width:350px){
.restore-notice{flex-direction:column;align-items:stretch}
.session-screen button.restore-button{align-self:flex-end}
}

/* 会话菜单：内容不足一屏时自适应收紧（单页显示，不出现滚动条），小屏超出时静默滚动。 */
.menu-sheet{display:flex;flex-direction:column}
.menu-sheet .sheet-scroll{height:auto;flex:0 1 auto;min-height:0;max-height:calc(90vh - 210rpx)}
