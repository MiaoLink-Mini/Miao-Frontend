<page-meta root-background-color="{{themeCanvas || '#171816'}}" page-style="background-color:{{themeCanvas || '#171816'}}" />
<view class="app-surface {{themeId}} motion-{{motionMode}} {{pageActive ? '' : 'is-hidden'}}" style="{{themeStyle}}">
<view wx:if="{{invited}}" class="page invitation-page"><view class="eyebrow">A LITTLE HELP, A BIG DIFFERENCE</view><view class="invite-art"><activity-mark size="large" active="{{pageActive}}"/></view><view class="title">一起，做点什么。</view><view class="subtitle">你收到了一个会话邀请。</view><view class="card invite-explain">接受后即可阅读记录。能否控制，由分享者设定。<view class="tiny section">邀请仅供首位接受者使用。</view></view><button wx:if="{{!authenticated}}" class="primary inline-action" bindtap="login">登录并继续<ui-icon name="arrow-up-right" size="{{28}}" tone="accentInk" /></button><button wx:else class="primary inline-action" bindtap="accept" disabled="{{busy || !live}}" loading="{{busy}}">接受邀请<ui-icon name="arrow-up-right" size="{{28}}" tone="accentInk" /></button><button class="quiet-button" bindtap="decline">暂不加入</button><view wx:if="{{error}}" class="error">{{error}}</view></view>
<view wx:elif="{{!authenticated}}" class="page empty"><view class="title">与我共享</view><button class="primary section" bindtap="login">登录后查看</button></view>
<view wx:elif="{{!id}}" class="page"><view class="row"><view><view class="eyebrow">SHARED WITH YOU</view><view class="title">与我共享</view></view></view><view class="subtitle">好的工作，一起完成。</view><view wx:for="{{shares}}" wx:key="id" class="card shared-list" bindtap="open" data-url="/pages/shared/index?id={{item.id}}"><view class="row"><text class="badge">{{item.permissionLabel}}</text><view class="chevron"><ui-icon name="arrow-up-right" size="{{32}}" tone="accent" /></view></view><view class="card-title section">{{item.title}}</view><view class="tiny">{{item.expiryLabel}} 到期</view></view><view wx:if="{{!shares.length && !loading}}" class="empty">还没有有效的共享会话</view><button wx:if="{{moreShares}}" class="secondary small" bindtap="moreShares">加载更多</button><view wx:if="{{error}}" class="error">{{error}}</view><button class="quiet-button" bindtap="retry">刷新</button></view>
<view wx:else class="shared-screen" style="height:calc(100vh - {{keyboardHeight}}px)"><block wx:if="{{meta}}"><view class="shared-header"><view class="row gap"><view class="grow"><view class="eyebrow">{{meta.ownerName || '好友'}} 的会话</view><view class="shared-title">{{session.title}}</view></view><button class="icon-button inline-action" bindtap="showThemes" aria-label="主题与动效"><ui-icon name="palette" size="{{38}}" tone="accent" /></button></view><view class="row grant-line"><text class="badge">{{grant.permissionLabel}} · {{grant.expiryLabel}} 到期</text><view class="tiny"><text class="dot {{meta.nodeOnline ? '' : 'offline'}}"></text>{{stateLabel}}</view></view></view>
<scroll-view class="shared-transcript" scroll-y enhanced show-scrollbar="{{false}}" scroll-into-view="{{scrollTarget}}" scroll-with-animation="{{scrollAnimated}}" binddragstart="dragStart" binddragging="dragging" binddragend="dragEnd"><view class="shared-body"><button wx:if="{{hasMore}}" class="quiet-button small" bindtap="loadMore">更早的消息</button><event-card wx:for="{{items}}" wx:key="key" item="{{item}}" agent="{{agent}}" large="{{preferences.largeText}}" readonly="{{true}}" bind:open="openEvent"/><view wx:if="{{active}}" class="working"><activity-mark active="{{pageActive}}" size="small"/><text>{{stateLabel}}</text></view><view id="shared-latest" class="transcript-end"></view></view></scroll-view>
<view class="shared-footer"><button wx:if="{{!following}}" class="jump-latest inline-action" bindtap="latest"><ui-icon name="arrow-down" size="{{28}}" tone="accent" /> 最新消息</button><view wx:for="{{pendingRequests}}" wx:key="id" class="pending-row row" bindtap="openPending" data-id="{{item.id}}"><text class="grow">{{item.title}}</text><view class="link inline-action"><text>{{isController ? '处理' : '查看'}}</text><ui-icon name="arrow-up-right" size="{{28}}" tone="accent" /></view></view><view wx:if="{{isController}}" class="shared-composer"><button wx:if="{{canQueue}}" class="queue-mode inline-action" bindtap="toggleQueue"><ui-icon name="{{queueMode ? 'check-circle' : 'queue'}}" size="{{28}}" tone="accent" /><text>{{queueMode ? '本轮结束后执行' : '选择排队发送'}}</text></button><textarea class="shared-input" auto-height value="{{draft}}" placeholder="{{active ? '追加一个任务…' : '说说下一步…'}}" bindinput="input" maxlength="4000" adjust-position="{{false}}" bindkeyboardheightchange="keyboard" disabled="{{busy || unknown}}"/><view class="row"><text class="tiny">{{meta.agentName}} · 协作模式</text><view class="row gap"><button wx:if="{{canCancel}}" class="stop-button inline-action" bindtap="cancel" disabled="{{busy || unknown}}" aria-label="停止"><ui-icon name="stop" size="{{38}}" tone="accent" /></button><button class="send-button inline-action" bindtap="send" disabled="{{!canSend || !draft || busy || unknown}}" loading="{{busy}}" aria-label="发送"><ui-icon name="arrow-up" size="{{38}}" tone="accentInk" /></button></view></view></view><view wx:else class="readonly-note">只读分享 · 内容自动更新</view><view wx:if="{{receipt}}" class="receipt">{{receipt}}</view><view wx:if="{{commandError}}" class="error">{{commandError}}</view><button wx:if="{{unknown}}" class="small secondary" bindtap="reconcileShared">查询原操作</button></view></block>
<view wx:else class="empty unavailable"><activity-mark wx:if="{{loading}}" active size="large"/><view wx:else class="unavailable-symbol"><ui-icon name="unlink" size="{{64}}" tone="quiet" /></view><view class="empty-title">{{loading ? '正在连接会话' : '访问已暂停'}}</view><view class="muted">{{error}}</view><view wx:if="{{unknown}}" class="notice">有操作结果待确认，请联系分享者核实。</view><button wx:if="{{!loading}}" class="secondary section" bindtap="retry">重新连接</button></view>
</view>
<view wx:if="{{detail && meta}}" class="detail-backdrop" bindtap="closeDetail"><view class="detail-sheet" catchtap="noop"><view class="row detail-heading"><text class="section-title">{{detail === 'diff' ? '代码改动' : '交互请求'}}</text><button class="icon-button inline-action" bindtap="closeDetail" aria-label="关闭"><ui-icon name="close" size="{{38}}" tone="accent" /></button></view><scroll-view scroll-y class="detail-scroll"><view class="detail-content"><view wx:if="{{detailError}}" class="error">{{detailError}}</view><view wx:if="{{detailLoading}}" class="working"><activity-mark active size="small"/><text>加载中</text></view><block wx:if="{{detail === 'diff'}}"><scroll-view scroll-x class="file-tabs"><view class="file-tab {{diff.id === item.id ? 'selected' : ''}}" wx:for="{{diffFiles}}" wx:key="id" bindtap="chooseDiff" data-id="{{item.id}}">{{item.name}}</view></scroll-view><code-diff wx:if="{{diff}}" patch="{{diff.patch}}" truncated="{{diff.truncated}}"/></block>
<block wx:elif="{{request}}"><view class="request-title">{{request.title}}</view><text class="request-summary" selectable>{{request.summary}}</text><view wx:if="{{request.action || request.scope}}" class="card"><text class="mono" selectable>{{request.action}}</text><view class="tiny">{{request.scope}}</view></view><view wx:if="{{request.state !== 'pending'}}" class="notice">此请求已处理或结束</view><block wx:if="{{request.kind === 'approval'}}"><button wx:for="{{request.choices}}" wx:key="id" class="secondary section" data-id="{{item.id}}" bindtap="approve" disabled="{{!isController || request.state !== 'pending' || busy || unknown}}">{{item.label}}</button></block>
<block wx:else><view wx:for="{{request.questions}}" wx:key="id" wx:for-item="question" class="question-field"><view class="field-label">{{question.label}}{{question.required ? ' *' : ''}}</view><radio-group wx:if="{{question.type === 'single'}}" data-id="{{question.id}}" bindchange="answer"><label wx:for="{{question.options}}" wx:key="id" wx:for-item="option" class="answer-option"><radio value="{{option.id}}" checked="{{answers[question.id] === option.id}}" color="{{accent}}" disabled="{{!isController || request.state !== 'pending' || busy || unknown}}"/><text>{{option.label}}</text></label></radio-group><checkbox-group wx:elif="{{question.type === 'multiple'}}" data-id="{{question.id}}" bindchange="answer"><label wx:for="{{question.options}}" wx:key="id" wx:for-item="option" class="answer-option"><checkbox value="{{option.id}}" color="{{accent}}" disabled="{{!isController || request.state !== 'pending' || busy || unknown}}"/><text>{{option.label}}</text></label></checkbox-group><textarea wx:else class="answer-textarea" value="{{answers[question.id] || ''}}" maxlength="{{question.maxLength}}" bindinput="answer" data-id="{{question.id}}" disabled="{{!isController || request.state !== 'pending' || busy || unknown}}" placeholder="输入回答"/></view><button class="primary section" bindtap="submitAnswer" disabled="{{!isController || request.state !== 'pending' || busy || unknown}}">提交回答</button></block><view wx:if="{{commandError}}" class="error">{{commandError}}</view><view wx:if="{{unknown}}" class="notice">正在等待回执，请勿重复提交。</view></block></view></scroll-view></view></view>
<theme-switcher open="{{themeSheet}}" selected="{{themeId}}" motion="{{motionMode}}" bind:close="closeThemes" bind:change="themeChange" bind:motion="motionChange"/>
</view>
