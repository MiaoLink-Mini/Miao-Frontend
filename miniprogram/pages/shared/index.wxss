.invitation-page{min-height:100vh;box-sizing:border-box;display:flex;flex-direction:column}
.invite-art{display:flex;align-items:center;justify-content:center;height:350rpx}
.invite-explain{font-size:28rpx;line-height:1.9;margin:36rpx 0}
.invitation-page>.primary{margin-top:auto}
.quiet-button{background:transparent;color:var(--muted);font-weight:400}
.shared-list{padding:28rpx}
.shared-list .tiny{margin-top:16rpx}
.shared-screen{display:flex;flex-direction:column;height:100vh;overflow:hidden;min-height:0}
.shared-header{padding:24rpx 30rpx 18rpx;border-bottom:1rpx solid var(--line-soft);flex-shrink:0}
.shared-title{font-size:32rpx;line-height:1.4;max-height:92rpx;overflow:hidden;margin-top:8rpx}
.grant-line{margin-top:18rpx}
.grant-line .badge{font-size:19rpx;background:var(--accent-soft);color:var(--accent);border:0}
.shared-transcript{flex:1;height:0;min-height:0}
.shared-body{padding:20rpx 28rpx}
.transcript-end{height:24rpx}
.working{display:flex;align-items:center;gap:16rpx;color:var(--muted);font-size:23rpx;padding:24rpx 0}
.shared-footer{flex-shrink:0;padding:12rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));position:relative}
.shared-composer{padding:20rpx 22rpx 16rpx;border:1rpx solid var(--line);border-radius:26rpx;background:var(--surface);box-shadow:var(--shadow)}
.shared-composer:focus-within{border-color:var(--accent)}
.shared-input{width:100%;min-height:64rpx;max-height:240rpx;color:var(--ink);font-size:28rpx;line-height:1.65;margin:4rpx 0 16rpx}
button.send-button,button.stop-button{width:68rpx;height:68rpx;min-height:0;padding:0;margin:0;border-radius:20rpx;line-height:68rpx;font-size:36rpx;background:var(--accent);color:var(--accent-ink)}
button.stop-button{font-size:22rpx;background:var(--raised);color:var(--ink)}
.readonly-note{text-align:center;color:var(--quiet);font-size:23rpx;padding:22rpx}
button.queue-mode{width:auto;font-size:22rpx;background:var(--accent-soft);color:var(--accent);padding:10rpx 16rpx;min-height:0;border-radius:14rpx;line-height:1.5;display:inline-block;font-weight:400;margin:0 0 12rpx}
.pending-row{background:var(--accent-soft);font-size:24rpx;padding:18rpx 24rpx;border-radius:18rpx;margin:0 0 12rpx}
.receipt{color:var(--quiet);font-size:20rpx;text-align:center;margin-top:10rpx}
button.jump-latest{width:auto;line-height:1.5;position:absolute;top:-68rpx;left:50%;transform:translateX(-50%);padding:10rpx 26rpx;border-radius:30rpx;background:var(--raised);border:1rpx solid var(--line);font-size:22rpx;font-weight:400;min-height:0}
.unavailable{margin:auto;width:90%;box-sizing:border-box}
.unavailable activity-mark{display:flex;justify-content:center;margin-bottom:28rpx}
.unavailable-symbol{font-size:90rpx;color:var(--quiet)}
.detail-backdrop{position:fixed;inset:0;background:#0008;z-index:110;display:flex;align-items:flex-end}
.detail-sheet{width:100%;max-height:92vh;background:var(--canvas);border-radius:32rpx 32rpx 0 0;border-top:1rpx solid var(--line);display:flex;flex-direction:column;animation:sheet-enter .28s cubic-bezier(.2,.75,.25,1) both}
.detail-heading{padding:22rpx 28rpx;flex-shrink:0}
.detail-scroll{height:76vh}
.detail-content{padding:0 26rpx calc(32rpx + env(safe-area-inset-bottom))}
.file-tabs{white-space:nowrap;margin-bottom:16rpx}
.file-tab{display:inline-block;font-family:ui-monospace,monospace;font-size:23rpx;padding:12rpx 18rpx;border:1rpx solid var(--line);margin-right:12rpx;border-radius:14rpx}
.file-tab.selected{background:var(--accent-soft);color:var(--accent)}
.request-title{font-size:36rpx;font-weight:500;margin:18rpx 0}
.request-summary{font-size:26rpx;line-height:1.7;white-space:pre-wrap;word-break:break-all}
.question-field{margin-top:28rpx}
.answer-option{display:flex;align-items:center;gap:12rpx;padding:20rpx;background:var(--surface);border-radius:16rpx;margin:10rpx 0;font-size:25rpx}
.answer-textarea{width:100%;height:180rpx;box-sizing:border-box;border:1rpx solid var(--line);padding:20rpx;color:var(--ink);background:var(--surface);border-radius:18rpx;font-size:26rpx}

/* Per-page refinement: explicit slots, readable metadata and stable hit areas. */
.grant-line{flex-wrap:wrap;gap:12rpx}
.grant-line>.badge{max-width:100%;white-space:normal;line-height:1.5}
.shared-header .icon-button{width:68rpx!important;height:68rpx}
.shared-title{overflow-wrap:anywhere}
button.jump-latest{width:auto;display:flex;align-items:center;gap:10rpx}
.shared-transcript .shared-body{padding-left:24rpx;padding-right:24rpx}
.shared-list:active{background:var(--raised)}
.shared-list .card-title{line-height:1.5}
.detail-sheet .row{gap:12rpx}
.detail-sheet .row>.card-title{min-width:0;overflow-wrap:anywhere}

button.queue-mode{width:auto;display:flex;align-items:center;gap:10rpx}.unavailable-symbol{display:flex;justify-content:center}
