<page-meta root-background-color="{{themeCanvas || '#171816'}}" page-style="background-color:{{themeCanvas || '#171816'}}" />
<view class="app-surface {{themeId}} motion-{{motionMode}} {{pageActive ? '' : 'is-hidden'}}" style="{{themeStyle}}"><connection-bar state="{{connection}}" label="{{connectionLabel}}"/>
<view class="page"><view class="screen-head"><view><view class="screen-kicker">远程工作环境</view><view class="title">设备</view></view><button class="primary small inline-action" bindtap="open" data-url="/pages/pair/index"><ui-icon name="plus" size="{{30}}" tone="accentInk" /> 添加</button></view>
 <view class="segmented"><text class="{{!revoked ? 'selected' : ''}}" bindtap="toggle" data-value="active">已绑定</text><text class="{{revoked ? 'selected' : ''}}" bindtap="toggle" data-value="revoked">已撤销</text></view>
 <view wx:for="{{list}}" wx:key="id" class="card device-tile" bindtap="open" data-url="/pages/node/index?id={{item.id}}"><view class="row gap"><view class="resource-symbol"><ui-icon name="monitor" size="{{32}}" tone="accent" /></view><view class="grow"><view class="card-title">{{item.name}}</view><text class="tiny">{{item.platform}}</text></view><text class="inline-status {{item.online ? 'online' : 'offline'}}">{{item.revoked ? '已撤销' : item.online ? '在线' : '离线'}}</text></view><view class="device-footer row"><text class="tiny">{{item.lastSeenLabel}}</text><view class="tiny inline-action"><text>{{item.active}} 个进行中</text><ui-icon name="chevron-right" size="{{28}}" tone="accent" /></view></view></view>
 <view wx:if="{{!list.length}}" class="compact-empty empty-actions"><view class="empty-title">{{revoked ? '没有已撤销的设备' : '暂无设备'}}</view><button wx:if="{{!revoked}}" class="secondary small inline-action" bindtap="open" data-url="/pages/pair/index">输入配对码</button></view>
</view><theme-switcher open="{{themeSheet}}" selected="{{themeId}}" motion="{{motionMode}}" bind:close="closeThemes" bind:change="themeChange" bind:motion="motionChange"/></view>
