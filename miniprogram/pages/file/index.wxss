

/* Per-page refinement: explicit slots, readable metadata and stable hit areas. */
.file-heading{display:flex;align-items:center;gap:20rpx;margin:8rpx 0 30rpx}
.file-heading .card-title{font-size:25rpx;line-height:1.6;margin-top:6rpx}
.file-heading .screen-kicker{margin:0}
