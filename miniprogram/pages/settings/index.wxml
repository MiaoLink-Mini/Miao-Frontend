<page-meta root-background-color="{{themeCanvas || '#171816'}}" page-style="background-color:{{themeCanvas || '#171816'}}" />
<view class="app-surface {{themeId}} motion-{{motionMode}} {{pageActive ? '' : 'is-hidden'}}" style="{{themeStyle}}">
<view class="page">
  <view class="title">偏好与隐私</view>
  <view class="card section row" bindtap="showThemes"><view><view>主题与动效</view><text class="tiny">{{themeName}}</text></view><view class="chevron"><ui-icon name="palette" size="{{32}}" tone="accent" /></view></view><view class="section-title section">界面与通知</view>
  <view class="card">
    <view class="row list-row">
      <view class="grow">
        <view>较大正文</view>
        <text class="tiny">用于总览与会话正文</text>
      </view>
      <switch checked="{{preferences.largeText}}" color="{{accent}}" bindchange="preference" data-key="largeText"/>
    </view>
    <view class="list-row">
      <text wx:if="{{!subscription.enabled}}" class="muted">待配置微信消息模板</text>
      <view wx:if="{{subscription.enabled}}" wx:for="{{subscription.templates}}" wx:key="id" class="row list-row"><view class="grow"><view>{{item.title}}</view><text wx:if="{{item.kind === 'completed'}}" class="tiny">当任务完成时通过微信订阅消息提醒</text></view><switch checked="{{subscriptionAccepted[item.id] || false}}" color="{{accent}}" bindchange="changeSubscription" data-id="{{item.id}}" disabled="{{subscriptionBusy || subscriptionPending}}"/></view>
      <view wx:if="{{subscriptionError}}" class="notice warning">{{subscriptionError}}</view>
      <button wx:if="{{subscriptionPending}}" bindtap="submitConsent" disabled="{{subscriptionBusy}}">查询原授权请求</button>
    </view>
  </view>
  <view class="section-title section" id="privacy">内容保留</view>
  <view class="card">
    <text class="body">正文与草稿仅留在本次登录。清除不影响远端文件。</text>
    <button class="secondary section" bindtap="clear">清除本地草稿与正文</button>
  </view>
  <view class="section-title section" id="about">关于 喵连</view>
  <view class="card">
    <view class="card-title">喵连 {{version}}</view>
    <view class="body muted">你的口袋编程工作台</view>
    <view class="link section" bindtap="open" data-url="/pages/guide/index?replay=1">查看使用指南<ui-icon name="arrow-up-right" size="{{28}}" tone="accent" /></view>
  </view>
</view>
<theme-switcher open="{{themeSheet}}" selected="{{themeId}}" motion="{{motionMode}}" bind:close="closeThemes" bind:change="themeChange" bind:motion="motionChange"/>
</view>
