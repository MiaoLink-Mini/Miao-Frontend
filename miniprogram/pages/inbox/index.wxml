<page-meta root-background-color="{{themeCanvas || '#171816'}}" page-style="background-color:{{themeCanvas || '#171816'}}" />
<import src="../../components/operation.wxml"/>
<view class="app-surface {{themeId}} motion-{{motionMode}} {{pageActive ? '' : 'is-hidden'}} tabbed" style="{{themeStyle}}">
<connection-bar state="{{connection}}" label="{{connectionLabel}}"/>
<view class="page">
 <view class="screen-head"><view><view class="screen-kicker">审批 · 提问 · 通知</view><view class="title">待处理</view></view><button class="attention-count" bindtap="fetchList" disabled="{{listLoading}}" aria-label="刷新待办">{{pendingCount}}<view class="inline-action"><text>项待办</text><ui-icon name="refresh" size="{{28}}" tone="accent" /></view></button></view>
 <view class="segmented"><text class="{{filter === 'pending' || filter === 'approval' || filter === 'question' ? 'selected' : ''}}" bindtap="filter" data-value="pending">待办</text><text class="{{filter === 'notices' ? 'selected' : ''}}" bindtap="filter" data-value="notices">通知</text><text class="{{filter === 'history' ? 'selected' : ''}}" bindtap="filter" data-value="history">已处理</text></view>
 <view wx:if="{{filter === 'pending' || filter === 'approval' || filter === 'question'}}" class="filters"><text class="filter {{filter === 'pending' ? 'active' : ''}}" bindtap="filter" data-value="pending">全部</text><text class="filter {{filter === 'approval' ? 'active' : ''}}" bindtap="filter" data-value="approval">审批 {{approvals}}</text><text class="filter {{filter === 'question' ? 'active' : ''}}" bindtap="filter" data-value="question">提问 {{questions}}</text></view>
 <block wx:if="{{filter !== 'notices'}}">
  <view wx:for="{{list}}" wx:key="id" class="card request-card {{item.kind}}" bindtap="open" data-url="/pages/request/index?id={{item.id}}"><view class="row"><text class="badge {{item.kind === 'approval' ? 'waiting_approval' : 'waiting_input'}}">{{item.kind === 'approval' ? '审批' : '提问'}} · {{item.stateLabel}}</text><text class="tiny">{{item.timeLabel}}</text></view><view class="card-title request-title">{{item.title}}</view><text class="request-summary muted">{{item.summary}}</text><view class="request-context"><view class="grow"><text class="tiny">{{item.contextLabel}}</text><view class="context-title">{{item.sessionTitle}}</view></view><view class="link inline-action"><text>{{filter === 'history' ? '查看' : '处理'}}</text><ui-icon name="chevron-right" size="{{28}}" tone="accent" /></view></view></view>
  <view wx:if="{{!list.length && !listLoading && !listError}}" class="list-empty"><view class="list-empty-icon"><ui-icon name="check" size="{{52}}" tone="accent" /></view><view class="list-empty-title">{{filter === 'history' ? '还没有处理记录' : '当前没有待办'}}</view></view>
 </block>
 <block wx:else><view class="surface-list"><view wx:for="{{notices}}" wx:key="id" class="notice-row" bindtap="notice" data-id="{{item.id}}"><view class="row"><text class="card-title grow">{{item.title}}</text><view wx:if="{{!item.read}}" class="unread-dot"/></view><text class="muted request-summary">{{item.summary}}</text></view></view><view wx:if="{{!notices.length && !listLoading && !listError}}" class="list-empty"><view class="list-empty-icon"><ui-icon name="bell" size="{{52}}" tone="accent" /></view><view class="list-empty-title">暂无通知</view></view></block>
 <view wx:if="{{listLoading}}" class="loading-row">正在加载</view><view wx:if="{{listError}}" class="error">{{listError}}</view><button wx:if="{{moreResults}}" class="secondary" bindtap="loadMore" disabled="{{listLoading}}">加载更多</button><button wx:if="{{listError}}" class="secondary" bindtap="fetchList" disabled="{{listLoading}}">重试</button><template is="operation" data="{{busy,receipt,error,unknown}}"/>
</view><theme-switcher open="{{themeSheet}}" selected="{{themeId}}" motion="{{motionMode}}" bind:close="closeThemes" bind:change="themeChange" bind:motion="motionChange"/>
</view>
