<page-meta root-background-color="{{themeCanvas || '#171816'}}" page-style="background-color:{{themeCanvas || '#171816'}}" />
<view class="app-surface {{themeId}} motion-{{motionMode}} {{pageActive ? '' : 'is-hidden'}}" style="{{themeStyle}}"><connection-bar state="{{connection}}" label="{{connectionLabel}}"/>
<view class="page"><view class="screen-head"><view><view class="screen-kicker">工作环境</view><view class="title">项目</view></view><button class="quiet-button inline-action" bindtap="open" data-url="/pages/nodes/index">设备<ui-icon name="chevron-right" size="{{28}}" tone="accent" /></button></view>
 <input class="search" placeholder="搜索项目或设备" value="{{query}}" bindinput="input"/>
 <view wx:for="{{projects}}" wx:key="id" class="card project-tile" bindtap="open" data-url="/pages/project/index?id={{item.id}}"><view class="row gap"><view class="resource-symbol"><ui-icon name="folder" size="{{32}}" tone="accent" /></view><view class="grow"><view class="card-title">{{item.name}}</view><text class="tiny">{{item.nodeName}}</text></view><view class="chevron"><ui-icon name="chevron-right" size="{{32}}" tone="quiet" /></view></view><text wx:if="{{item.description}}" class="project-description muted">{{item.description}}</text><view class="project-footer row"><text class="mono tiny">{{item.branch || '分支未上报'}}</text><text class="inline-status {{item.valid ? 'online' : 'offline'}}">{{item.valid ? '目录有效' : '目录不可用'}}</text></view></view>
 <view wx:if="{{!projects.length}}" class="compact-empty">{{query ? '没有匹配的项目' : '在主机登记的授权项目会显示在这里'}}</view>
</view><theme-switcher open="{{themeSheet}}" selected="{{themeId}}" motion="{{motionMode}}" bind:close="closeThemes" bind:change="themeChange" bind:motion="motionChange"/></view>
