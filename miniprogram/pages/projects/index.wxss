.search{margin-bottom:28rpx}
.project-tile{padding:26rpx}
.project-description{display:block;font-size:25rpx;line-height:1.6;margin-top:18rpx}
.project-footer{border-top:1rpx solid var(--line);margin-top:22rpx;padding-top:18rpx}
.project-footer .mono{max-width:70%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}

/* Per-page refinement: explicit slots, readable metadata and stable hit areas. */
.project-tile{padding:26rpx;border-color:var(--line-soft)}
.project-tile:active{background:var(--raised)}
.project-tile .card-title{font-size:29rpx}
.project-tile .tiny{overflow-wrap:anywhere}
.project-tile .chevron{margin-left:auto}
.search{margin-top:16rpx}
