.profile-editor{padding-bottom:calc(180rpx + env(safe-area-inset-bottom))}
.profile-photo{display:flex;flex-direction:column;align-items:center;padding:36rpx 0 42rpx;gap:20rpx}
.profile-photo button.avatar-chooser:not([size='mini']){display:flex;flex:none;align-items:center;justify-content:center;width:160rpx;min-width:160rpx;max-width:160rpx;height:160rpx;min-height:160rpx;padding:0;margin:0;line-height:normal;border-radius:50%;overflow:hidden;border:2rpx solid var(--line);background:var(--raised)}
.editor-avatar{display:block;flex:none;width:160rpx;height:160rpx;border-radius:50%}
.photo-label{font-size:28rpx;color:var(--muted)}
.profile-editor button.text-button:not([size='mini']){width:auto;min-height:56rpx;margin:0;padding:8rpx 20rpx;line-height:40rpx;font-size:26rpx;color:var(--accent);background:transparent;border:0}
.nickname-field{padding:28rpx}
.nickname-field .field-label{margin-top:0}
.nickname-field input{box-sizing:border-box;width:100%;height:88rpx;padding:0 24rpx;line-height:normal;color:var(--ink);font-size:32rpx}
.reload-profile{margin-top:16rpx}
.profile-save{position:fixed;bottom:0;left:0;right:0;padding:24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));background:var(--canvas);border-top:1rpx solid var(--line-soft)}
