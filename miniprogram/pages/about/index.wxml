<page-meta root-background-color="{{themeCanvas || '#171816'}}" page-style="background-color:{{themeCanvas || '#171816'}}" />
<view class="app-surface {{themeId}} motion-{{motionMode}} {{pageActive ? '' : 'is-hidden'}}" style="{{themeStyle}}"><view class="page">
 <view class="about-hero"><image class="about-logo" src="/assets/golink.png" mode="aspectFit" aria-label="喵连 图标" /><view class="about-name">喵连</view><text class="tiny">版本 {{version}}</text><view class="about-intro">随时连接你的 Coding Agent：代码保留在你的电脑上，用手机实时查看输出、审阅改动、确认审批。</view></view>
 <view class="subhead">开发者</view>
 <view class="surface-list"><view wx:for="{{developers}}" wx:key="name" class="row-button" bindtap="copyGithub" data-name="{{item.name}}" role="button" aria-label="复制 {{item.name}} 的 GitHub 地址"><image class="dev-avatar" src="{{item.avatar}}" mode="aspectFill" aria-label="{{item.name}} 的 GitHub 头像" /><view class="grow"><view>{{item.name}} · {{item.role}}</view><text class="tiny">{{item.url}}</text></view><view class="chevron"><ui-icon name="copy" size="{{30}}" tone="quiet" /></view></view></view>
 <view class="subhead">开源仓库</view>
 <view class="surface-list"><view wx:for="{{repos}}" wx:key="name" class="row-button" bindtap="copyRepo" data-name="{{item.name}}" role="button" aria-label="复制 {{item.name}} 仓库地址"><view class="row-icon"><ui-icon name="link" size="{{32}}" tone="accent" /></view><view class="grow"><view>{{item.name}}</view><text class="tiny">{{item.label}} · MIT</text></view><view class="chevron"><ui-icon name="copy" size="{{30}}" tone="quiet" /></view></view></view>
</view>
<theme-switcher open="{{themeSheet}}" selected="{{themeId}}" motion="{{motionMode}}" bind:close="closeThemes" bind:change="themeChange" bind:motion="motionChange"/>
</view>
