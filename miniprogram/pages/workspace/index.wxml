<page-meta root-background-color="{{themeCanvas || '#171816'}}" page-style="background-color:{{themeCanvas || '#171816'}}" />
<import src="../../components/operation.wxml"/>
<template name="workspace-control">
 <view class="control-panel">
  <view class="row-button" bindtap="toggleForm" data-id="{{form.id}}"><text class="grow">{{form.label}}</text><view class="chevron"><ui-icon name="{{form.expanded ? 'chevron-up' : 'chevron-down'}}" size="{{32}}" tone="quiet"/></view></view>
  <view wx:if="{{form.expanded}}" class="control-body">
   <text wx:if="{{form.notice}}" class="tiny">{{form.notice}}</text>
   <view wx:for="{{form.fields}}" wx:for-item="field" wx:key="key" class="field"><text>{{field.label}}</text>
    <picker wx:if="{{field.type === 'select'}}" mode="selector" range="{{field.options}}" range-key="label" value="{{field.selected}}" bindchange="fieldInput" data-id="{{form.id}}" data-key="{{field.key}}" disabled="{{busy || unknown}}"><view class="input">{{field.options[field.selected].label}}</view></picker>
    <switch wx:elif="{{field.type === 'boolean'}}" checked="{{field.value}}" bindchange="fieldInput" data-id="{{form.id}}" data-key="{{field.key}}" disabled="{{busy || unknown}}"/>
    <textarea wx:else value="{{field.value}}" maxlength="{{field.maxLength}}" auto-height bindinput="fieldInput" data-id="{{form.id}}" data-key="{{field.key}}" disabled="{{busy || unknown}}"/>
   </view><button class="secondary" bindtap="perform" data-id="{{form.id}}" disabled="{{busy || unknown}}">{{form.label}}</button>
  </view>
 </view>
</template>
<view class="app-surface {{themeId}} motion-{{motionMode}} {{pageActive ? '' : 'is-hidden'}}" style="{{themeStyle}}">
<view class="page workspace">
 <view class="breadcrumb" bindtap="returnToSession"><ui-icon name="arrow-left" size="{{30}}" tone="accent" /><text>{{projectHistory ? '返回' : '返回对话'}}</text><text wx:if="{{session}}">{{session.title}}</text></view>
 <view class="screen-head"><view class="grow"><view class="screen-kicker">{{session && session.agent ? session.agent.name : '喵连'}} · 会话工具</view><view class="title">{{pageTitle}}</view></view><button class="icon-button inline-action" aria-label="刷新" bindtap="reload" disabled="{{busy || unknown}}"><ui-icon name="refresh" size="{{38}}" tone="accent" /></button></view>
 <view wx:if="!projectHistory" class="workspace-path"><button wx:if="{{kind !== 'overview'}}" class="quiet-button" size="mini" bindtap="home" disabled="{{busy || unknown}}">全部工具</button><button wx:if="{{kind !== 'organization'}}" class="quiet-button" size="mini" bindtap="showOrganization" disabled="{{busy || unknown}}">整理会话</button><button class="quiet-button" size="mini" bindtap="open" data-url="/pages/panel/index?kind=menu&amp;sessionId={{id}}">会话菜单</button></view>
 <template is="operation" data="{{busy,receipt,error}}"/><button wx:if="{{unknown}}" class="secondary" bindtap="retryPending" disabled="{{busy}}">查询原操作</button>
 <block wx:if="{{kind !== 'organization'}}">
  <view wx:if="{{view && (view.truncated || fileNotice || view.externalUrl || view.prefill)}}" class="workspace-result">
   <view wx:if="{{view.truncated}}" class="notice warning">结果已截断</view><text wx:if="{{fileNotice}}" class="notice warning">{{fileNotice}}</text>
   <view wx:if="{{view.text}}" class="card"><view class="card-title">{{view.title}}</view><text class="file-text" selectable>{{view.text}}</text></view>
   <view wx:if="{{view.externalUrl}}" class="card"><text class="body" selectable>{{view.externalUrl}}</text><button class="secondary" bindtap="copyExternal">复制授权链接</button></view>
   <view wx:if="{{view.prefill}}" class="card"><text class="body" selectable>{{view.prefill}}</text><button class="secondary" bindtap="prefill">追加到草稿</button><button class="quiet-button" bindtap="finishSelection">返回编辑</button></view>
  </view>
  <block wx:if="{{kind === 'overview'}}"><view wx:for="{{catalogGroups}}" wx:key="title" wx:for-item="group"><view class="subhead">{{group.title}}</view><view class="surface-list"><view wx:for="{{group.items}}" wx:key="id" class="row-button" bindtap="openEntry" data-id="{{item.id}}"><view class="grow"><view>{{item.title}}</view><text wx:if="{{item.state}}" class="tiny">{{item.state}}</text></view><view wx:if="{{item.request}}" class="chevron"><ui-icon name="chevron-right" size="{{32}}" tone="quiet" /></view></view></view></view></block>
  <block wx:else>
   <view wx:if="{{kind === 'thinking'}}" class="surface-list thinking-list"><view wx:for="{{entries}}" wx:key="id" class="row-button thinking-row {{item.state === 'current' ? 'thinking-current' : ''}}" bindtap="chooseThinking" data-id="{{item.id}}" role="button" aria-label="选择 {{item.label}}"><view class="grow"><view class="thinking-name">{{item.label}}</view><text wx:if="{{item.detail}}" class="tiny">{{item.detail}}</text></view><view class="thinking-check"><ui-icon name="check-circle" size="{{34}}" tone="accent" wx:if="{{item.state === 'current'}}"/></view></view></view>
   <view wx:if="{{kind !== 'thinking'}}" wx:for="{{entries}}" wx:key="id" class="card workspace-entry">
    <view class="row"><view class="card-title grow">{{item.label}}</view><text class="tiny">{{item.state}}</text></view><text wx:if="{{item.detail}}" class="body muted" selectable>{{item.detail}}</text>
    <view class="entry-actions"><button wx:if="{{item.request}}" size="mini" class="secondary inline-action" bindtap="openEntry" data-id="{{item.id}}" disabled="{{busy || unknown}}">打开<ui-icon name="chevron-right" size="{{28}}" tone="accent" /></button><button wx:if="{{item.referenceId}}" size="mini" class="secondary inline-action" bindtap="select" data-id="{{item.id}}" disabled="{{busy || unknown}}"><ui-icon name="plus" size="{{30}}" tone="accent" /> 加入草稿</button><button wx:if="{{item.preset}}" size="mini" class="secondary" bindtap="usePreset" data-id="{{item.id}}" disabled="{{busy || unknown}}">用此 Agent 新建</button></view>
    <block wx:if="{{item.origin}}"><text wx:if="{{item.origin.pointLabel}}" class="tiny" selectable>分支起点：{{item.origin.pointLabel}}</text><view class="entry-actions"><button wx:if="{{item.origin.mode === 'import'}}" size="mini" bindtap="branch" data-id="{{item.id}}" data-mode="import" disabled="{{busy || unknown}}">导入并继续</button><button wx:if="{{item.origin.mode !== 'import' && !item.origin.pointId}}" size="mini" bindtap="branch" data-id="{{item.id}}" data-mode="resume" disabled="{{busy || unknown}}">恢复</button><button wx:if="{{item.origin.mode !== 'import'}}" size="mini" bindtap="branch" data-id="{{item.id}}" data-mode="fork" disabled="{{busy || unknown}}">分支</button><button wx:if="{{item.origin.mode !== 'import'}}" size="mini" bindtap="branch" data-id="{{item.id}}" data-mode="clone" disabled="{{busy || unknown}}">克隆</button></view></block>
    <block wx:for="{{item.formItems}}" wx:for-item="form" wx:key="id"><template is="workspace-control" data="{{form,busy,unknown}}"/></block>
   </view>
  </block>
  <view wx:if="{{view && !entries.length && !globalForms.length && !view.text && !view.prefill && !view.externalUrl && kind !== 'attachments'}}" class="compact-empty">当前没有条目<text class="tiny">{{view.title}}</text></view>
  <view wx:if="{{view && paginationForms.length}}" class="catalog-pagination"><button wx:for="{{paginationForms}}" wx:for-item="form" wx:key="id" class="secondary" bindtap="perform" data-id="{{form.id}}" disabled="{{busy || unknown}}">{{form.label}}</button></view>
  <view wx:if="{{globalForms.length}}" class="subhead">可用操作</view><view wx:for="{{globalForms}}" wx:for-item="form" wx:key="id" class="surface-list global-operation"><template is="workspace-control" data="{{form,busy,unknown}}"/></view>
  <view wx:if="{{kind === 'attachments'}}" class="card">
   <view class="card-title">添加附件</view><text class="tiny">单文件 512 KiB，本次输入合计 600 KiB</text>
   <view class="entry-actions"><button class="secondary inline-action" bindtap="chooseImage" disabled="{{busy || unknown}}"><ui-icon name="plus" size="{{30}}" tone="accent" /> 图片</button><button class="secondary inline-action" bindtap="chooseFile" disabled="{{busy || unknown}}"><ui-icon name="plus" size="{{30}}" tone="accent" /> 文件</button></view>
   <view wx:for="{{jobs}}" wx:key="id" class="upload-row"><view>{{item.name}}</view><text class="tiny">{{item.state}} · {{item.offset}} / {{item.size}} bytes</text><text class="warning">{{item.error}}</text><image class="artifact-image" wx:if="{{item.previewPath}}" src="{{item.previewPath}}" mode="widthFix" bindtap="preview" data-path="{{item.previewPath}}"/>
    <view class="entry-actions"><button wx:if="{{item.state !== 'received' && item.state !== 'accepted'}}" size="mini" bindtap="uploadJob" data-id="{{item.id}}" disabled="{{busy}}">{{item.state === 'unknown' ? '查询并继续' : '上传至主机'}}</button><button wx:if="{{item.state === 'received' || item.state === 'accepted'}}" size="mini" bindtap="selectUpload" data-id="{{item.id}}">加入草稿</button><button size="mini" class="quiet-button" bindtap="removeUpload" data-id="{{item.id}}" disabled="{{busy}}">移除</button></view>
   </view>
  </view>
  <view wx:if="{{selection.length}}" class="selection-bar card"><view class="row"><view class="card-title">已选 {{selection.length}} 项</view><text class="link" bindtap="clearSelection">清空</text></view><view wx:for="{{selection}}" wx:key="id" class="tiny">{{item.label}}</view><text class="tiny">回到对话点击发送后，Agent 才会收到。</text><button class="primary" bindtap="finishSelection" disabled="{{busy || unknown}}">完成，返回草稿</button></view>
 </block>
 <block wx:if="{{kind === 'organization' && session}}">
  <view class="surface-list organization-fields"><view class="field"><text class="tiny">会话名称</text><input value="{{metadataTitle}}" bindinput="metadataInput" data-key="metadataTitle" maxlength="200" placeholder="会话名称"/></view><view class="field"><text class="tiny">标签</text><input value="{{metadataTags}}" bindinput="metadataInput" data-key="metadataTags" maxlength="409" placeholder="用英文逗号分隔"/></view><view class="row-button"><text>置顶</text><switch checked="{{metadataPinned}}" bindchange="metadataInput" data-key="metadataPinned"/></view><view class="row-button"><view class="grow"><view>归档</view><text class="tiny">不会停止远程任务</text></view><switch checked="{{metadataArchived}}" bindchange="metadataInput" data-key="metadataArchived"/></view></view>
  <button class="primary" bindtap="saveMetadata" disabled="{{busy || unknown || !metadataDirty}}">保存</button>
  <view class="subhead">文本快照</view><view class="surface-list"><view class="row-button" bindtap="exportTranscript"><view class="grow"><view>导出对话</view><text class="tiny">文本快照，非原生存档</text></view><view><ui-icon name="arrow-up-right" size="{{32}}" tone="accent" /></view></view><view class="row-button" bindtap="importTranscript"><text>导入只读快照</text><view><ui-icon name="chevron-right" size="{{32}}" tone="quiet" /></view></view></view>
  <view wx:if="{{session.parentSessionId || children.length}}"><view class="subhead">会话关系</view><text class="tiny">仅显示已加载的关联会话</text><button wx:if="{{session.parentSessionId}}" size="mini" bindtap="open" data-url="/pages/session/index?id={{session.parentSessionId}}">查看来源会话</button><view wx:for="{{children}}" wx:key="id" class="row-button" bindtap="open" data-url="/pages/session/index?id={{item.id}}"><text>{{item.title}}</text><view><ui-icon name="chevron-right" size="{{32}}" tone="quiet" /></view></view></view>
  <view class="subhead">清理历史</view><view class="card"><text class="tiny">仅清除平台正文，不删除主机文件。会话需先关闭。</text><view class="row"><text>包含子会话（最多 100 个）</text><switch checked="{{deleteChildren}}" bindchange="deleteChildrenInput" disabled="{{busy || unknown}}"/></view><button class="danger" bindtap="deleteTranscript" disabled="{{busy || unknown || session.state !== 'closed'}}">清除平台正文</button></view>
 </block>
 <view wx:if="{{downloaded}}" class="card"><view>{{downloaded.name}}</view><text class="tiny">{{receipt}}</text><image class="artifact-image" wx:if="{{downloaded.mediaType === 'image/png' || downloaded.mediaType === 'image/jpeg' || downloaded.mediaType === 'image/webp' || downloaded.mediaType === 'image/gif'}}" src="{{downloaded.filePath}}" mode="widthFix" bindtap="preview" data-path="{{downloaded.filePath}}"/><button class="secondary" bindtap="share">转发文件到微信</button></view>
</view>
<theme-switcher open="{{themeSheet}}" selected="{{themeId}}" motion="{{motionMode}}" bind:close="closeThemes" bind:change="themeChange" bind:motion="motionChange"/>
</view>
