.tab-shell{position:fixed;left:0;right:0;bottom:0;z-index:90;padding:10rpx 24rpx calc(12rpx + env(safe-area-inset-bottom));pointer-events:none;background:linear-gradient(transparent,var(--canvas))}
.tab-dock{height:108rpx;min-height:60px;padding:6rpx;border:1rpx solid var(--line);border-radius:32rpx;background:var(--surface);box-shadow:0 10rpx 32rpx #00000012;pointer-events:auto;box-sizing:border-box}
.tab-track{position:relative;display:flex;width:100%;height:100%;box-sizing:border-box}
/* Keep the flex layout above the shared mini-button reset. */
.tab-track .tab-item{position:relative;display:flex;flex:1 1 0;width:25%;min-width:0;height:100%;margin:0;padding:0;border:0;background:transparent;color:var(--quiet);border-radius:24rpx;align-items:center;justify-content:center;flex-direction:column;gap:4rpx;line-height:1.3;box-sizing:border-box;z-index:1}
.tab-item::after{border:0}
.tab-item.current{color:var(--accent)}
.tab-item.tab-pressed{opacity:.65}
.tab-icon-wrap{position:relative;display:flex;align-items:center;justify-content:center;width:44rpx;height:44rpx;flex:none}
.tab-text{font-size:22rpx;font-weight:600;white-space:nowrap;letter-spacing:.3rpx}
.tab-slider{position:absolute;top:0;bottom:0;left:0;width:25%;padding:0 2rpx;box-sizing:border-box;transition:transform .28s cubic-bezier(.2,.8,.2,1);pointer-events:none}
.tab-slider-fill{width:100%;height:100%;border-radius:24rpx;background:var(--accent-soft)}
.tab-badge{position:absolute;top:-7rpx;left:32rpx;height:27rpx;min-width:27rpx;padding:0 6rpx;display:flex;align-items:center;justify-content:center;box-sizing:border-box;border:3rpx solid var(--surface);border-radius:20rpx;background:var(--accent);color:var(--accent-ink);font-size:16rpx;font-weight:700;line-height:1;font-variant-numeric:tabular-nums;white-space:nowrap}
.motion-off .tab-slider,.motion-reduced .tab-slider{transition:none}
